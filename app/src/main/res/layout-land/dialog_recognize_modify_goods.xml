<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusableInTouchMode="true"
    android:padding="@dimen/dp_6"
    android:background="@drawable/land_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_26"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="@dimen/dp_58"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp_9"
            android:textColor="#293A51"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:text="@string/modify_goods_title"
            android:layout_weight="0" />

        <EditText
            android:id="@+id/editText"
            android:layout_width="@dimen/dp_0"
            android:layout_weight="1"
            android:layout_height="@dimen/dp_24"
            android:paddingHorizontal="@dimen/dp_6"
            android:background="@drawable/land_input"
            android:textColor="#293A51"
            android:textColorHint="#637187"
            android:textSize="@dimen/sp_8"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:hint="@string/goods_management_search_hint" />

        <ImageView
            android:id="@+id/clearText"
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_24"
            android:padding="@dimen/dp_5"
            android:visibility="gone"
            android:src="@drawable/baseline_cancel_24"
            android:contentDescription="@string/goods_clear" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_24"
            android:textSize="@dimen/sp_7"
            android:textColor="#3F3EED"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:text="@string/goods_input_chinese"
            android:id="@+id/searchChinese"
            android:gravity="center"
            android:paddingHorizontal="@dimen/dp_4"
            android:background="@drawable/land_soft"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="@dimen/dp_4" />
    </LinearLayout>

    <FrameLayout
        android:layout_marginTop="@dimen/dp_5"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/resultRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textSize="@dimen/sp_8"
            android:textColor="#637187"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:text="@string/goods_search_empty"
            android:id="@+id/searchEmpty"
            android:gravity="center" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/searchKeyboard"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dp_2"
        android:background="@drawable/land_input"
        android:layout_marginTop="@dimen/dp_2" />
</LinearLayout>