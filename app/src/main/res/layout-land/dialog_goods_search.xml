<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:focusableInTouchMode="true" android:padding="12dp" android:background="@drawable/land_card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical">
        <TextView android:layout_width="116dp" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="#293A51" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:text="@string/goods_search_title" android:layout_weight="0" />
        <EditText android:id="@+id/searchQuery" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:paddingHorizontal="12dp" android:background="@drawable/land_input" android:textColor="#293A51" android:textColorHint="#637187" android:textSize="16sp" android:singleLine="true" android:inputType="text" android:imeOptions="actionDone" android:hint="@string/goods_management_search_hint" />
        <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:textSize="14sp" android:textColor="#3F3EED" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:text="@string/goods_input_chinese" android:id="@+id/searchChinese" android:gravity="center" android:paddingHorizontal="8dp" android:background="@drawable/land_soft" android:clickable="true" android:focusable="true" android:layout_marginStart="8dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:textSize="16sp" android:textColor="#3F3EED" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:text="@string/button_cancel" android:id="@+id/searchCancel" android:gravity="center" android:paddingHorizontal="8dp" android:background="@drawable/land_soft" android:clickable="true" android:focusable="true" android:layout_marginStart="4dp" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#637187" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:text="@string/goods_search_instruction" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/searchResults" android:layout_width="match_parent" android:layout_height="match_parent" />
        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:textSize="16sp" android:textColor="#637187" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:text="@string/goods_search_empty" android:id="@+id/searchEmpty" android:gravity="center" />
    </FrameLayout>
    <LinearLayout android:id="@+id/searchKeyboard" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="4dp" android:background="@drawable/land_input" android:layout_marginTop="4dp" />
</LinearLayout>