<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/dp_8"
        android:paddingRight="@dimen/dp_8"
        android:paddingTop="@dimen/dp_6"
        android:paddingBottom="@dimen/dp_6">

        <ScrollView
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dp_8"
                android:background="@drawable/land_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp_36"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/sp_10"
                            android:textColor="#293A51"
                            android:includeFontPadding="false"
                            android:text="@string/settings_system_print_module"
                            android:textStyle="bold"
                            android:fontFamily="@font/retail_sans" />

                        <Space
                            android:layout_width="@dimen/dp_0_5"
                            android:layout_height="@dimen/dp_3" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/sp_7_5"
                            android:textColor="#6E7C90"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="@dimen/dp_1_5"
                            android:text="@string/land_printing_hint"
                            android:fontFamily="@font/retail_sans" />
                    </LinearLayout>

                    <cc.huoyan.retail.common.ui.LandscapeSwitch
                        android:layout_width="@dimen/dp_26"
                        android:layout_height="@dimen/dp_24"
                        android:id="@+id/printModule"
                        android:showText="false"
                        android:thumb="@drawable/land_switch_thumb"
                        android:track="@drawable/land_switch_track"
                        android:splitTrack="false"
                        android:switchMinWidth="@dimen/dp_26"
                        android:thumbTint="@null"
                        android:trackTint="@null"
                        android:padding="@dimen/dp_0" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_8" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:id="@+id/printInitNameLayout"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#293A51"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="@string/settings_system_printer_type"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="@dimen/dp_125"
                        android:layout_height="wrap_content"
                        android:id="@+id/printerTypeName"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:text="@string/land_placeholder"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="@dimen/dp_12"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_13"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:text="@string/land_chevron"
                        android:fontFamily="@font/retail_sans" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_8" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:id="@+id/printerModelLayout"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#293A51"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="@string/settings_system_printer_model"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="@dimen/dp_140"
                        android:layout_height="wrap_content"
                        android:id="@+id/printerModel"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/land_placeholder"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="@dimen/dp_12"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_13"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:text="@string/land_chevron"
                        android:fontFamily="@font/retail_sans" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_8" />

                <include layout="@layout/printer_paper_setting" />

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_8" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:id="@+id/printerConnection"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#293A51"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="@string/land_connection_type"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end|center_vertical"
                        android:text="@string/land_usb"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="@dimen/dp_12"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_13"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:text="@string/land_chevron"
                        android:fontFamily="@font/retail_sans" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_8" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_24"
                    android:id="@+id/printerStatus"
                    android:textSize="@dimen/sp_8"
                    android:textColor="#27835B"
                    android:includeFontPadding="false"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/dp_8"
                    android:background="@drawable/land_success"
                    android:visibility="invisible"
                    android:fontFamily="@font/retail_sans" />

                <TextView
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_0"
                    android:id="@+id/printerInitName"
                    android:textSize="@dimen/sp_9"
                    android:textColor="#293A51"
                    android:includeFontPadding="false"
                    android:visibility="gone"
                    android:fontFamily="@font/retail_sans" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingHorizontal="@dimen/dp_8">

        <Space
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:layout_width="@dimen/dp_84"
            android:layout_height="@dimen/dp_26"
            android:id="@+id/communicationTest"
            android:textSize="@dimen/sp_9"
            android:textColor="#3F3EED"
            android:includeFontPadding="false"
            android:gravity="center"
            android:background="@drawable/land_soft"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="@dimen/dp_8"
            android:text="@string/settings_system_printer_test_connection"
            android:textStyle="bold"
            android:fontFamily="@font/retail_sans" />

        <TextView
            android:layout_width="@dimen/dp_100"
            android:layout_height="@dimen/dp_26"
            android:id="@+id/printTest"
            android:textSize="@dimen/sp_9"
            android:textColor="#FFFFFF"
            android:includeFontPadding="false"
            android:gravity="center"
            android:background="@drawable/land_primary"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="@dimen/dp_8"
            android:text="@string/settings_system_printer_test_print"
            android:textStyle="bold"
            android:fontFamily="@font/retail_sans" />
    </LinearLayout>
</LinearLayout>
