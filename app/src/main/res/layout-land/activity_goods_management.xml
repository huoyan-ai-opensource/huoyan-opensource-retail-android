<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F2F4F8">
    <include layout="@layout/land_page_navigation" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="@dimen/ui_page_horizontal" android:paddingTop="12dp" android:paddingBottom="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:layout_marginBottom="12dp">
            <EditText android:id="@+id/managementSearch" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:hint="@string/goods_management_search_hint" android:background="@drawable/land_card" android:paddingHorizontal="10dp" android:textSize="16sp" android:textColor="#293A51" android:textColorHint="#637187" android:singleLine="true" android:inputType="text" android:imeOptions="actionSearch" />
            <TextView android:id="@+id/managementSort" android:layout_width="184dp" android:layout_height="48dp" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:textSize="16sp" android:textColor="#293A51" android:background="@drawable/land_card" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:text="@string/goods_management_sort" android:drawableEnd="@drawable/baseline_keyboard_arrow_down_24" android:drawablePadding="8dp" android:singleLine="true" android:ellipsize="end" android:clickable="true" android:focusable="true" android:layout_marginStart="8dp" />
            <TextView android:id="@+id/managementPricing" android:layout_width="152dp" android:layout_height="48dp" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:textSize="16sp" android:textColor="#293A51" android:background="@drawable/land_card" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:text="@string/goods_management_pricing" android:drawableEnd="@drawable/baseline_keyboard_arrow_down_24" android:drawablePadding="8dp" android:singleLine="true" android:ellipsize="end" android:clickable="true" android:focusable="true" android:layout_marginStart="8dp" />
            <TextView android:layout_width="112dp" android:layout_height="48dp" android:textSize="16sp" android:textColor="#FFFFFF" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:text="@string/learning_add_goods" android:id="@+id/managementAdd" android:gravity="center" android:paddingHorizontal="4dp" android:background="@drawable/land_primary" android:clickable="true" android:focusable="true" android:layout_marginStart="8dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:id="@+id/managementColumns" android:gravity="center_vertical" android:paddingHorizontal="@dimen/ui_page_horizontal" android:layout_marginTop="0dp" android:background="@drawable/land_table_header">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#637187" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:text="@string/goods_columns_name" android:layout_weight="1" />
            <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#637187" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:text="PLU" android:layout_weight="0" />
            <TextView android:layout_width="112dp" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#637187" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:text="@string/goods_columns_price" android:layout_weight="0" />
            <TextView android:layout_width="88dp" android:layout_height="wrap_content" android:text="@string/goods_columns_learned" android:textSize="15sp" android:textColor="#637187" />
            <TextView android:layout_width="224dp" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#637187" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:text="@string/goods_columns_actions" android:layout_weight="0" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/land_table_body">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/managementList" android:layout_width="match_parent" android:layout_height="match_parent" />
            <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:textSize="16sp" android:textColor="#637187" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/managementEmpty" android:gravity="center" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>