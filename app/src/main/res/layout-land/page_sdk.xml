<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F4F8">

    <LinearLayout
        android:layout_width="@dimen/dp_160"
        android:layout_height="@dimen/dp_24"
        android:orientation="horizontal"
        android:layout_marginHorizontal="@dimen/dp_8"
        android:layout_marginTop="@dimen/dp_6"
        android:padding="@dimen/dp_2"
        android:background="@drawable/sdk_tabs_background">

        <TextView
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:textSize="@dimen/sp_9"
            android:textColor="#6E7C90"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:text="@string/land_sdk_aidl"
            android:id="@+id/sdkAidl"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/sdk_tab"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="@dimen/dp_0" />

        <TextView
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:textSize="@dimen/sp_9"
            android:textColor="#6E7C90"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:text="@string/land_sdk_ws"
            android:id="@+id/sdkWs"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/sdk_tab"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="@dimen/dp_2" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/dp_8"
        android:layout_marginVertical="@dimen/dp_6">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/sdkLocalContent"
            android:padding="@dimen/dp_8"
            android:background="@drawable/land_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp_10"
                android:textColor="#293A51"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:text="@string/land_sdk_aidl" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp_9"
                android:textColor="#293A51"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:text="@string/land_sdk_save_first"
                android:id="@+id/sdkLocalStatus"
                android:layout_marginTop="@dimen/dp_6" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp_8"
                android:textColor="#293A51"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:text="@string/sdk_local_help"
                android:id="@+id/sdkLocalTitle"
                android:layout_marginTop="@dimen/dp_6" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sdkLanContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="@dimen/dp_0"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:id="@+id/sdkIpCard"
                android:padding="@dimen/dp_8"
                android:background="@drawable/land_card"
                android:layout_weight="1">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_9"
                    android:textColor="#293A51"
                    android:fontFamily="@font/retail_sans"
                    android:includeFontPadding="false"
                    android:text="@string/land_sdk_device_ip" />

                <EditText
                    android:id="@+id/wsAddress"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:layout_marginTop="@dimen/dp_6"
                    android:textSize="@dimen/sp_9"
                    android:textColor="#293A51"
                    android:textColorHint="#6E7C90"
                    android:fontFamily="@font/retail_sans"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="@dimen/dp_8"
                    android:background="@drawable/land_field"
                    android:hint="@string/land_sdk_ip_hint"
                    android:maxLength="15"
                    android:digits="0123456789." />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_8"
                    android:textColor="#6E7C90"
                    android:fontFamily="@font/retail_sans"
                    android:includeFontPadding="false"
                    android:text="@string/land_sdk_ip_help"
                    android:layout_marginTop="@dimen/dp_8" />

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_0"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_8"
                    android:textColor="#27835B"
                    android:fontFamily="@font/retail_sans"
                    android:includeFontPadding="false"
                    android:text="@string/land_connection_untested"
                    android:id="@+id/wsStatus"
                    android:minHeight="@dimen/dp_32"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/dp_6"
                    android:padding="@dimen/dp_8"
                    android:background="@drawable/land_success" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="@dimen/dp_0"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_weight="1"
                android:id="@+id/sdkDiscoveryCard"
                android:padding="@dimen/dp_8"
                android:background="@drawable/land_card"
                android:layout_marginStart="@dimen/dp_8">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_9"
                    android:textColor="#293A51"
                    android:fontFamily="@font/retail_sans"
                    android:includeFontPadding="false"
                    android:text="@string/land_discovered_devices" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_0"
                    android:layout_weight="1"
                    android:layout_marginVertical="@dimen/dp_6">

                    <ListView
                        android:id="@+id/wsResults"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:divider="@android:color/transparent"
                        android:dividerHeight="@dimen/dp_3"
                        android:choiceMode="singleChoice"
                        android:listSelector="@android:color/transparent" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_8"
                        android:textColor="#6E7C90"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:text="@string/sdk_discovery_empty"
                        android:id="@+id/sdkDiscoveryEmpty"
                        android:gravity="center" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_7"
                    android:textColor="#6E7C90"
                    android:fontFamily="@font/retail_sans"
                    android:includeFontPadding="false"
                    android:text="@string/land_discovery_select_hint" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/sdkActions"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/dp_8"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="@dimen/dp_92"
            android:layout_height="@dimen/dp_26"
            android:textSize="@dimen/sp_9"
            android:textColor="#3F3EED"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:text="@string/ws_test"
            android:id="@+id/wsProbe"
            android:gravity="center"
            android:background="@drawable/land_soft"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="@dimen/dp_92"
            android:layout_height="@dimen/dp_26"
            android:textSize="@dimen/sp_9"
            android:textColor="#3F3EED"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:text="@string/ws_discover"
            android:id="@+id/wsDiscover"
            android:gravity="center"
            android:background="@drawable/land_soft"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="@dimen/dp_6" />

        <Space
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_0_5"
            android:layout_weight="1" />

        <TextView
            android:layout_width="@dimen/dp_100"
            android:layout_height="@dimen/dp_26"
            android:textSize="@dimen/sp_9"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:text="@string/land_save_connection"
            android:id="@+id/confirm"
            android:gravity="center"
            android:background="@drawable/land_primary"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
