<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/dp_8"
        android:paddingRight="@dimen/dp_8"
        android:paddingTop="@dimen/dp_6"
        android:paddingBottom="@dimen/dp_6">

        <ScrollView
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:layout_weight="520">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dp_8"
                android:background="@drawable/land_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_36"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/sp_10"
                            android:textColor="#293A51"
                            android:includeFontPadding="false"
                            android:text="@string/settings_system_weighing_module"
                            android:textStyle="bold"
                            android:fontFamily="@font/retail_sans" />

                        <Space
                            android:layout_width="@dimen/dp_0_5"
                            android:layout_height="@dimen/dp_3" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/sp_7_5"
                            android:textColor="#6E7C90"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="@dimen/dp_1_5"
                            android:text="@string/land_weighing_hint"
                            android:fontFamily="@font/retail_sans" />
                    </LinearLayout>

                    <cc.huoyan.retail.common.ui.LandscapeSwitch
                        android:layout_width="@dimen/dp_26"
                        android:layout_height="@dimen/dp_24"
                        android:id="@+id/weighingModule"
                        android:showText="false"
                        android:thumb="@drawable/land_switch_thumb"
                        android:track="@drawable/land_switch_track"
                        android:splitTrack="false"
                        android:switchMinWidth="@dimen/dp_26"
                        android:thumbTint="@null"
                        android:trackTint="@null"
                        android:padding="@dimen/dp_0" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_8" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:id="@+id/scaleBrand"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#293A51"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="@string/settings_scale_brand"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end|center_vertical"
                        android:text="@string/land_scale_aclas"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="@dimen/dp_12"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_13"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:text="@string/land_chevron"
                        android:fontFamily="@font/retail_sans" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_8" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/selectScalePort"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/dp_32"
                    android:paddingTop="@dimen/dp_3"
                    android:paddingBottom="@dimen/dp_3">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#293A51"
                        android:includeFontPadding="false"
                        android:gravity="start|center_vertical"
                        android:text="@string/settings_scale_select_port"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/selectedScalePort"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="start|center_vertical"
                        android:text="@string/land_placeholder"
                        android:fontFamily="@font/retail_sans"
                        android:layout_marginTop="@dimen/dp_3"
                        android:maxLines="2"
                        android:ellipsize="end" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_8" />

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_8" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_8"
                    android:textColor="#6E7C90"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="@dimen/dp_1_5"
                    android:text="@string/land_scale_test_hint"
                    android:fontFamily="@font/retail_sans" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:layout_weight="672"
            android:layout_marginStart="@dimen/dp_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dp_8"
                android:background="@drawable/land_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_24"
                    android:id="@+id/scaleTestStatus"
                    android:textSize="@dimen/sp_8"
                    android:textColor="#27835B"
                    android:includeFontPadding="false"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/dp_8"
                    android:background="@drawable/land_success"
                    android:text="@string/land_scale_not_started"
                    android:fontFamily="@font/retail_sans" />

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_11" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_10"
                    android:textColor="#6E7C90"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="@dimen/dp_1_5"
                    android:text="@string/land_net_weight"
                    android:fontFamily="@font/retail_sans" />

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_11" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_55"
                    android:gravity="bottom">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/scaleWeight"
                        android:textSize="@dimen/sp_38"
                        android:textColor="#293A51"
                        android:includeFontPadding="false"
                        android:text="@string/text_weight_initial"
                        android:textStyle="bold"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_12"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:layout_marginStart="@dimen/dp_10"
                        android:layout_marginBottom="@dimen/dp_5"
                        android:text="@string/display_unit_weight"
                        android:fontFamily="@font/retail_sans" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_11" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/scaleStable"
                    android:textSize="@dimen/sp_9"
                    android:textColor="#27835B"
                    android:includeFontPadding="false"
                    android:text="@string/land_waiting_weight"
                    android:fontFamily="@font/retail_sans" />

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_11" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="@dimen/dp_26"
                        android:id="@+id/zeroScale"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#3F3EED"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:background="@drawable/land_soft"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_weight="1"
                        android:text="@string/settings_scale_zero"
                        android:textStyle="bold"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="@dimen/dp_26"
                        android:id="@+id/tareScale"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#3F3EED"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:background="@drawable/land_soft"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_8"
                        android:text="@string/settings_scale_tare"
                        android:textStyle="bold"
                        android:fontFamily="@font/retail_sans" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingHorizontal="@dimen/dp_8">

        <Space
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:layout_width="@dimen/dp_100"
            android:layout_height="@dimen/dp_26"
            android:id="@+id/testScalePort"
            android:textSize="@dimen/sp_9"
            android:textColor="#FFFFFF"
            android:includeFontPadding="false"
            android:gravity="center"
            android:background="@drawable/land_primary"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="@dimen/dp_8"
            android:text="@string/land_start_scale_test"
            android:textStyle="bold"
            android:fontFamily="@font/retail_sans" />
    </LinearLayout>
</LinearLayout>
