<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="PageNavigationTitle">
        <item name="android:textColor">#293A51</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/retail_sans</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="WsDialogAction">
        <item name="android:layout_width">@dimen/dp_0</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/dp_24</item>
        <item name="android:padding">@dimen/dp_6</item>
        <item name="android:background">@drawable/btn_e1e3ea_radius_3</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#293A51</item>
        <item name="android:textSize">@dimen/sp_8</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowAnimationStyle">@style/NoPageAnimation</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="AppTheme.Fullscreen" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowAnimationStyle">@style/NoPageAnimation</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <declare-styleable name="RoundMaskFrameLayout">
        <!-- 定义一个名为 customSize 的属性，类型为 dimension -->
        <attr name="radiusSize" format="dimension" />
    </declare-styleable>

    <style name="RecognizeCountKeyStyle">
        <item name="android:layout_width">@dimen/dp_0</item>
        <item name="android:layout_height">@dimen/dp_27</item>
        <item name="android:layout_marginLeft">@dimen/dp_2_5</item>
        <item name="android:layout_marginRight">@dimen/dp_2_5</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_recognize_keypad_key</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#293A51</item>
        <item name="android:textSize">@dimen/sp_11_5</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="RecognizeCountDeleteKey" parent="RecognizeCountKeyStyle">
        <item name="android:background">@drawable/bg_recognize_keypad_delete</item>
        <item name="android:textColor">#C94F4F</item>
        <item name="android:textSize">@dimen/sp_10</item>
    </style>

    <style name="RecognizeCountSecondaryAction">
        <item name="android:layout_width">@dimen/dp_0</item>
        <item name="android:layout_height">@dimen/dp_30</item>
        <item name="android:layout_marginRight">@dimen/dp_4</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_recognize_keypad_neutral</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#293A51</item>
        <item name="android:textSize">@dimen/sp_10_5</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="RecognizeCountPrimaryAction">
        <item name="android:layout_width">@dimen/dp_0</item>
        <item name="android:layout_height">@dimen/dp_30</item>
        <item name="android:layout_marginLeft">@dimen/dp_4</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_recognize_keypad_action</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/sp_10_5</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="NoPageAnimation" parent="android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
    </style>

    <style name="RetailSdkPermissionAction">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/dp_4</item>
        <item name="android:minHeight">@dimen/dp_24</item>
        <item name="android:paddingHorizontal">@dimen/dp_6</item>
        <item name="android:paddingVertical">@dimen/dp_4</item>
        <item name="android:background">@drawable/land_field</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/retail_sans</item>
        <item name="android:textSize">@dimen/sp_8</item>
        <item name="android:textColor">#3F3EED</item>
    </style>
</resources>
