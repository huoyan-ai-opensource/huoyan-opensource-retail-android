<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F4F8">

    <include layout="@layout/land_page_navigation" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingTop="@dimen/dp_6"
        android:paddingBottom="@dimen/dp_8">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_28"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/dp_6">

            <EditText
                android:id="@+id/managementSearch"
                android:layout_width="@dimen/dp_0"
                android:layout_weight="1"
                android:layout_height="@dimen/dp_26"
                android:hint="@string/goods_management_search_hint"
                android:background="@drawable/land_card"
                android:paddingHorizontal="@dimen/dp_5"
                android:textSize="@dimen/sp_8"
                android:textColor="#293A51"
                android:textColorHint="#637187"
                android:singleLine="true"
                android:inputType="text"
                android:imeOptions="actionSearch" />

            <TextView
                android:id="@+id/managementSort"
                android:layout_width="@dimen/dp_120"
                android:layout_height="@dimen/dp_24"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/dp_6"
                android:textSize="@dimen/sp_8"
                android:textColor="#293A51"
                android:background="@drawable/land_card"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:text="@string/goods_management_sort"
                android:drawableEnd="@drawable/baseline_keyboard_arrow_down_24"
                android:drawablePadding="@dimen/dp_4"
                android:singleLine="true"
                android:ellipsize="end"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="@dimen/dp_4" />

            <TextView
                android:id="@+id/managementPricing"
                android:layout_width="@dimen/dp_72"
                android:layout_height="@dimen/dp_24"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/dp_6"
                android:textSize="@dimen/sp_8"
                android:textColor="#293A51"
                android:background="@drawable/land_card"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:text="@string/goods_management_pricing"
                android:drawableEnd="@drawable/baseline_keyboard_arrow_down_24"
                android:drawablePadding="@dimen/dp_4"
                android:singleLine="true"
                android:ellipsize="end"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="@dimen/dp_4" />

            <TextView
                android:layout_width="@dimen/dp_70"
                android:layout_height="@dimen/dp_24"
                android:textSize="@dimen/sp_8"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:text="@string/learning_add_goods"
                android:id="@+id/managementAdd"
                android:gravity="center"
                android:paddingHorizontal="@dimen/dp_2"
                android:background="@drawable/land_primary"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="@dimen/dp_4" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_26"
            android:id="@+id/managementColumns"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/dp_10"
            android:layout_marginTop="@dimen/dp_0"
            android:background="@drawable/land_table_header">

            <TextView
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp_7_5"
                android:textColor="#637187"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:text="@string/goods_columns_name"
                android:layout_weight="1" />

            <TextView
                android:layout_width="@dimen/dp_58"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp_7_5"
                android:textColor="#637187"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:text="PLU"
                android:layout_weight="0" />

            <TextView
                android:layout_width="@dimen/dp_86"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp_7_5"
                android:textColor="#637187"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:text="@string/goods_columns_price"
                android:layout_weight="0" />

            <TextView
                android:layout_width="@dimen/dp_60"
                android:layout_height="wrap_content"
                android:text="@string/goods_columns_learned"
                android:textSize="@dimen/sp_7_5"
                android:textColor="#637187" />

            <TextView
                android:layout_width="@dimen/dp_146"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp_7_5"
                android:textColor="#637187"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:text="@string/goods_columns_actions"
                android:layout_weight="0" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0"
            android:layout_weight="1"
            android:background="@drawable/land_table_body">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/managementList"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textSize="@dimen/sp_8"
                android:textColor="#637187"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:id="@+id/managementEmpty"
                android:gravity="center" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>