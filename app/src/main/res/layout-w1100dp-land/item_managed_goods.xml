<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:background="@drawable/land_card">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="#293A51" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/manageName" android:layout_weight="1" android:maxLines="2" android:ellipsize="end" />
        <TextView android:layout_width="116dp" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#637187" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/managePlu" />
        <TextView android:layout_width="172dp" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#637187" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/managePrice" />
        <TextView android:id="@+id/manageLearned" android:layout_width="120dp" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#637187" android:gravity="center_vertical" />
    </LinearLayout>
    <TextView android:layout_width="120dp" android:layout_height="48dp" android:textSize="16sp" android:textColor="#3F3EED" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:text="@string/goods_enter_learning" android:id="@+id/manageLearn" android:gravity="center" android:paddingHorizontal="4dp" android:background="@drawable/land_soft" android:clickable="true" android:focusable="true" android:layout_marginStart="4dp" />
    <TextView android:layout_width="80dp" android:layout_height="48dp" android:textSize="16sp" android:textColor="#3F3EED" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:text="@string/learning_edit" android:id="@+id/manageEdit" android:gravity="center" android:paddingHorizontal="4dp" android:background="@drawable/land_soft" android:clickable="true" android:focusable="true" android:layout_marginStart="4dp" />
    <TextView android:layout_width="80dp" android:layout_height="48dp" android:textSize="16sp" android:textColor="#D92D20" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:text="@string/learning_delete" android:id="@+id/manageDelete" android:gravity="center" android:paddingHorizontal="4dp" android:background="@drawable/land_danger" android:clickable="true" android:focusable="true" android:layout_marginStart="4dp" />
</LinearLayout>