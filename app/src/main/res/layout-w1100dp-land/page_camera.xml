<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F2F4F8">
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:paddingLeft="@dimen/ui_page_horizontal" android:paddingRight="@dimen/ui_page_horizontal" android:paddingTop="@dimen/ui_page_vertical" android:paddingBottom="@dimen/ui_page_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="440" android:orientation="vertical" android:padding="@dimen/ui_card_padding" android:background="@drawable/land_card">
      <TextView android:layout_width="match_parent" android:layout_height="35dp" android:textSize="24sp" android:textColor="#293A51" android:includeFontPadding="false" android:gravity="center_vertical" android:text="@string/land_camera_display_settings" android:textStyle="bold" android:fontFamily="@font/retail_sans" />
      <Space android:layout_width="1dp" android:layout_height="18dp" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:id="@+id/cameraTypeLayout" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:textSize="18sp" android:textColor="#293A51" android:includeFontPadding="false" android:layout_weight="1" android:gravity="center_vertical" android:text="@string/settings_camera_type" android:fontFamily="@font/retail_sans" />
        <TextView android:layout_width="200dp" android:layout_height="wrap_content" android:id="@+id/cameraType" android:textSize="18sp" android:textColor="#6E7C90" android:includeFontPadding="false" android:gravity="end" android:maxLines="1" android:ellipsize="end" android:text="@string/camera_type_uvc" android:fontFamily="@font/retail_sans" />
        <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:textSize="26sp" android:textColor="#6E7C90" android:includeFontPadding="false" android:gravity="end" android:text="@string/land_chevron" android:fontFamily="@font/retail_sans" />
      </LinearLayout>
      <Space android:layout_width="1dp" android:layout_height="18dp" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:id="@+id/cameraNameLayout" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:textSize="18sp" android:textColor="#293A51" android:includeFontPadding="false" android:layout_weight="1" android:gravity="center_vertical" android:text="@string/settings_camera_select" android:fontFamily="@font/retail_sans" />
        <TextView android:layout_width="200dp" android:layout_height="wrap_content" android:id="@+id/cameraName" android:textSize="18sp" android:textColor="#6E7C90" android:includeFontPadding="false" android:gravity="end" android:maxLines="1" android:ellipsize="end" android:text="@string/settings_camera_select" android:fontFamily="@font/retail_sans" />
        <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:textSize="26sp" android:textColor="#6E7C90" android:includeFontPadding="false" android:gravity="end" android:text="@string/land_chevron" android:fontFamily="@font/retail_sans" />
      </LinearLayout>
      <Space android:layout_width="1dp" android:layout_height="18dp" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:id="@+id/cameraResolutionLayout" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:textSize="18sp" android:textColor="#293A51" android:includeFontPadding="false" android:layout_weight="1" android:gravity="center_vertical" android:text="@string/settings_camera_resolution_label" android:fontFamily="@font/retail_sans" />
        <TextView android:layout_width="200dp" android:layout_height="wrap_content" android:id="@+id/cameraResolution" android:textSize="18sp" android:textColor="#6E7C90" android:includeFontPadding="false" android:gravity="end" android:text="@string/land_placeholder" android:fontFamily="@font/retail_sans" />
        <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:textSize="26sp" android:textColor="#6E7C90" android:includeFontPadding="false" android:gravity="end" android:text="@string/land_chevron" android:fontFamily="@font/retail_sans" />
      </LinearLayout>
      <Space android:layout_width="1dp" android:layout_height="18dp" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="20sp" android:textColor="#293A51" android:includeFontPadding="false" android:text="@string/settings_camera_mirror" android:textStyle="bold" android:fontFamily="@font/retail_sans" />
          <Space android:layout_width="1dp" android:layout_height="6dp" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#6E7C90" android:includeFontPadding="false" android:lineSpacingExtra="3dp" android:text="@string/land_mirror_hint" android:fontFamily="@font/retail_sans" />
        </LinearLayout>
        <cc.huoyan.retail.common.ui.LandscapeSwitch android:layout_width="52dp" android:layout_height="48dp" android:id="@+id/cameraMirror" android:showText="false" android:thumb="@drawable/land_switch_thumb" android:track="@drawable/land_switch_track" android:splitTrack="false" android:switchMinWidth="52dp" android:thumbTint="@null" android:trackTint="@null" android:padding="0dp" />
      </LinearLayout>
      <Space android:layout_width="1dp" android:layout_height="18dp" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#6E7C90" android:includeFontPadding="false" android:lineSpacingExtra="3dp" android:text="@string/land_camera_setup_hint" android:fontFamily="@font/retail_sans" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="752" android:orientation="vertical" android:padding="@dimen/ui_card_padding" android:background="@drawable/land_card" android:layout_marginStart="24dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="22sp" android:textColor="#293A51" android:includeFontPadding="false" android:layout_weight="1" android:text="@string/settings_camera_preview" android:textStyle="bold" android:fontFamily="@font/retail_sans" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/cameraStatus" android:textSize="16sp" android:textColor="#6E7C90" android:includeFontPadding="false" android:text="@string/land_disconnected" android:fontFamily="@font/retail_sans" />
      </LinearLayout>
      <Space android:layout_width="1dp" android:layout_height="16dp" />
      <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="200dp" android:background="@drawable/land_preview" android:clipToOutline="true">
        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/imageViewText" android:textSize="22sp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:gravity="center" android:text="@string/land_device_preview" android:fontFamily="@font/retail_sans" />
        <cc.huoyan.retail.device.camera.AutoFitTextureView android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/surfaceView" android:layout_gravity="center" />
        <cc.huoyan.retail.device.camera.ResizableDashedBoxView android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/boxView" />
      </FrameLayout>
      <Space android:layout_width="1dp" android:layout_height="16dp" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#6E7C90" android:includeFontPadding="false" android:lineSpacingExtra="3dp" android:text="@string/land_camera_coordinates_hint" android:fontFamily="@font/retail_sans" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
