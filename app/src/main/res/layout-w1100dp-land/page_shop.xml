<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/dp_16"
        android:paddingRight="@dimen/dp_16"
        android:paddingTop="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_8">

        <LinearLayout
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="@dimen/dp_12"
            android:background="@drawable/land_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_17_5"
                android:textSize="@dimen/sp_12"
                android:textColor="#293A51"
                android:includeFontPadding="false"
                android:gravity="center_vertical"
                android:text="@string/land_shop_receipt_details"
                android:textStyle="bold"
                android:fontFamily="@font/retail_sans" />

            <Space
                android:layout_width="@dimen/dp_0_5"
                android:layout_height="@dimen/dp_10" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp_8"
                android:textColor="#6E7C90"
                android:includeFontPadding="false"
                android:text="@string/settings_system_shop_name"
                android:fontFamily="@font/retail_sans" />

            <Space
                android:layout_width="@dimen/dp_0_5"
                android:layout_height="@dimen/dp_5" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_26"
                android:id="@+id/shop_name"
                android:textSize="@dimen/sp_9"
                android:textColor="#293A51"
                android:textColorHint="#6E7C90"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:inputType="text"
                android:paddingHorizontal="@dimen/dp_8"
                android:background="@drawable/land_field"
                android:hint="@string/settings_system_shop_name_input_hint"
                android:fontFamily="@font/retail_sans" />

            <Space
                android:layout_width="@dimen/dp_0_5"
                android:layout_height="@dimen/dp_10" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp_8"
                android:textColor="#6E7C90"
                android:includeFontPadding="false"
                android:text="@string/settings_system_shop_phone"
                android:fontFamily="@font/retail_sans" />

            <Space
                android:layout_width="@dimen/dp_0_5"
                android:layout_height="@dimen/dp_5" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_26"
                android:id="@+id/shopPhone"
                android:textSize="@dimen/sp_9"
                android:textColor="#293A51"
                android:textColorHint="#6E7C90"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:inputType="phone"
                android:paddingHorizontal="@dimen/dp_8"
                android:background="@drawable/land_field"
                android:hint="@string/land_shop_phone_hint"
                android:fontFamily="@font/retail_sans" />

            <Space
                android:layout_width="@dimen/dp_0_5"
                android:layout_height="@dimen/dp_10" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp_8"
                android:textColor="#6E7C90"
                android:includeFontPadding="false"
                android:text="@string/settings_system_shop_address"
                android:fontFamily="@font/retail_sans" />

            <Space
                android:layout_width="@dimen/dp_0_5"
                android:layout_height="@dimen/dp_5" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_26"
                android:id="@+id/shopAddress"
                android:textSize="@dimen/sp_9"
                android:textColor="#293A51"
                android:textColorHint="#6E7C90"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:inputType="textPostalAddress"
                android:paddingHorizontal="@dimen/dp_8"
                android:background="@drawable/land_field"
                android:hint="@string/settings_system_shop_address_input_hint"
                android:fontFamily="@font/retail_sans" />

            <Space
                android:layout_width="@dimen/dp_0_5"
                android:layout_height="@dimen/dp_10" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingHorizontal="@dimen/dp_16">

        <Space
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:layout_width="@dimen/dp_72"
            android:layout_height="@dimen/dp_26"
            android:id="@+id/shopLogin"
            android:textSize="@dimen/sp_9"
            android:textColor="#3F3EED"
            android:includeFontPadding="false"
            android:gravity="center"
            android:background="@drawable/land_soft"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="@dimen/dp_8"
            android:text="@string/settings_system_shop_login"
            android:textStyle="bold"
            android:fontFamily="@font/retail_sans" />

        <TextView
            android:layout_width="@dimen/dp_100"
            android:layout_height="@dimen/dp_26"
            android:id="@+id/saveShop"
            android:textSize="@dimen/sp_9"
            android:textColor="#FFFFFF"
            android:includeFontPadding="false"
            android:gravity="center"
            android:background="@drawable/land_primary"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="@dimen/dp_8"
            android:text="@string/land_save_shop"
            android:textStyle="bold"
            android:fontFamily="@font/retail_sans" />
    </LinearLayout>
</LinearLayout>
