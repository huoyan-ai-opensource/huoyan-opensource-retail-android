<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#70142033"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="@dimen/dp_254"
        android:layout_height="@dimen/dp_255"
        android:layout_gravity="center"
        android:layout_marginVertical="@dimen/dp_8"
        android:orientation="vertical"
        android:padding="@dimen/dp_12"
        android:background="@drawable/land_card">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_21"
                    android:textSize="@dimen/sp_12"
                    android:textColor="#293A51"
                    android:fontFamily="@font/retail_sans"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:id="@+id/goodsName"
                    android:text="@string/goods_add_title"
                    android:textStyle="bold"
                    android:layout_marginTop="@dimen/dp_4" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_13"
                    android:textSize="@dimen/sp_8_5"
                    android:textColor="#293A51"
                    android:fontFamily="@font/retail_sans"
                    android:includeFontPadding="false"
                    android:gravity="center_vertical"
                    android:id="@+id/goodsPluLabel"
                    android:text="@string/land_goods_plu"
                    android:layout_marginTop="@dimen/dp_4" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_24"
                    android:textSize="@dimen/sp_8"
                    android:textColor="#293A51"
                    android:fontFamily="@font/retail_sans"
                    android:includeFontPadding="false"
                    android:gravity="start|center_vertical"
                    android:id="@+id/plu"
                    android:hint="@string/goods_plu_hint"
                    android:textColorHint="#6E7C90"
                    android:background="@drawable/land_field"
                    android:singleLine="true"
                    android:inputType="textVisiblePassword"
                    android:paddingHorizontal="@dimen/dp_8"
                    android:textAlignment="viewStart"
                    android:maxLength="32"
                    android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
                    android:layout_marginTop="@dimen/dp_4"
                    android:imeOptions="flagNoExtractUi|actionNext" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_13"
                    android:textSize="@dimen/sp_8_5"
                    android:textColor="#293A51"
                    android:fontFamily="@font/retail_sans"
                    android:includeFontPadding="false"
                    android:gravity="center_vertical"
                    android:id="@+id/goodsNameLabel"
                    android:text="@string/land_goods_name"
                    android:layout_marginTop="@dimen/dp_4" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_24"
                    android:textSize="@dimen/sp_8"
                    android:textColor="#293A51"
                    android:fontFamily="@font/retail_sans"
                    android:includeFontPadding="false"
                    android:gravity="start|center_vertical"
                    android:id="@+id/name"
                    android:hint="@string/goods_name_hint"
                    android:textColorHint="#6E7C90"
                    android:background="@drawable/land_field"
                    android:singleLine="true"
                    android:inputType="text"
                    android:paddingHorizontal="@dimen/dp_8"
                    android:textAlignment="viewStart"
                    android:maxLength="64"
                    android:layout_marginTop="@dimen/dp_4"
                    android:imeOptions="flagNoExtractUi|actionNext" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/dp_4">

                    <LinearLayout
                        android:layout_width="@dimen/dp_0"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_13"
                            android:textSize="@dimen/sp_8_5"
                            android:textColor="#293A51"
                            android:fontFamily="@font/retail_sans"
                            android:includeFontPadding="false"
                            android:gravity="center_vertical"
                            android:id="@+id/goodsPriceLabel"
                            android:text="@string/goods_price_weight" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_24"
                            android:textSize="@dimen/sp_8"
                            android:textColor="#293A51"
                            android:fontFamily="@font/retail_sans"
                            android:includeFontPadding="false"
                            android:gravity="start|center_vertical"
                            android:id="@+id/price"
                            android:hint="@string/goods_price_hint"
                            android:textColorHint="#6E7C90"
                            android:background="@drawable/land_field"
                            android:singleLine="true"
                            android:paddingHorizontal="@dimen/dp_8"
                            android:textAlignment="viewStart"
                            android:clickable="true"
                            android:focusable="true"
                            android:freezesText="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/goodsTareField"
                        android:layout_width="@dimen/dp_0"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_6"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_13"
                            android:includeFontPadding="false"
                            android:gravity="center_vertical"
                            android:text="@string/goods_tare_label"
                            android:textSize="@dimen/sp_8_5"
                            android:textColor="#293A51"
                            android:fontFamily="@font/retail_sans" />

                        <TextView
                            android:id="@+id/goodsTare"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_24"
                            android:text="0"
                            android:textSize="@dimen/sp_8"
                            android:textColor="#293A51"
                            android:fontFamily="@font/retail_sans"
                            android:background="@drawable/land_field"
                            android:paddingHorizontal="@dimen/dp_8"
                            android:singleLine="true"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:freezesText="true" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_13"
                    android:textSize="@dimen/sp_8_5"
                    android:textColor="#293A51"
                    android:fontFamily="@font/retail_sans"
                    android:includeFontPadding="false"
                    android:gravity="center_vertical"
                    android:id="@+id/goodsPricingLabel"
                    android:text="@string/land_goods_pricing"
                    android:layout_marginTop="@dimen/dp_4" />

                <RadioGroup
                    android:id="@+id/pricingType"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_24"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/dp_4">

                    <RadioButton
                        android:id="@+id/pricingTypeWeight"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:button="@null"
                        android:background="@drawable/land_pricing_option"
                        android:gravity="center"
                        android:text="@string/goods_pricing_type_weight"
                        android:textColor="@color/goods_pricing_text"
                        android:textSize="@dimen/sp_8"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:checked="true"
                        android:layout_weight="1" />

                    <RadioButton
                        android:id="@+id/pricingTypeCount"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:button="@null"
                        android:background="@drawable/land_pricing_option"
                        android:gravity="center"
                        android:text="@string/goods_pricing_type_count"
                        android:textColor="@color/goods_pricing_text"
                        android:textSize="@dimen/sp_8"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:layout_marginLeft="@dimen/dp_6"
                        android:layout_weight="1" />
                </RadioGroup>

            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_6">

            <TextView
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_24"
                android:textSize="@dimen/sp_8"
                android:textColor="#293A51"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:gravity="center"
                android:id="@+id/close"
                android:text="@string/button_close"
                android:background="@drawable/land_secondary"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_weight="1" />

            <TextView
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_24"
                android:textSize="@dimen/sp_8"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:gravity="center"
                android:id="@+id/confirm"
                android:text="@string/button_ok"
                android:background="@drawable/land_primary"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_6" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
