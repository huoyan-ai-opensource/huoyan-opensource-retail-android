<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 窄横屏卡片采用上下结构，让标题和说明使用整张卡片的宽度。 -->
    <style name="HomeFeatureCard" parent="HomeFeatureCardWide">
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">8dp</item>
    </style>
    <style name="HomeFeatureText" parent="HomeFeatureTextWide">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_weight">0</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>
    <dimen name="home_checkout_padding">20dp</dimen>
    <dimen name="home_feature_icon_size">24dp</dimen>
    <dimen name="home_feature_title_height">24dp</dimen>
    <dimen name="home_feature_title_size">18sp</dimen>
    <dimen name="home_feature_subtitle_height">18dp</dimen>
    <dimen name="home_feature_subtitle_gap">4dp</dimen>
    <integer name="home_feature_text_gravity">17</integer>
</resources>
