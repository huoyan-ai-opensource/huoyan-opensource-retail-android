<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 窄横屏卡片采用上下结构，让标题和说明使用整张卡片的宽度。 -->
    <style name="HomeFeatureCard" parent="HomeFeatureCardWide">
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">@dimen/dp_4</item>
    </style>

    <style name="HomeFeatureText" parent="HomeFeatureTextWide">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_weight">0</item>
        <item name="android:layout_marginStart">@dimen/dp_0</item>
        <item name="android:layout_marginTop">@dimen/dp_3</item>
    </style>

    <style name="HomeFeatureIcon" parent="HomeFeatureIconWide">
        <item name="android:layout_width">@dimen/dp_12</item>
        <item name="android:layout_height">@dimen/dp_12</item>
    </style>

    <style name="HomeFeatureTitle" parent="HomeFeatureTitleWide">
        <item name="android:minHeight">@dimen/dp_12</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/sp_9</item>
    </style>

    <style name="HomeFeatureSubtitle" parent="HomeFeatureSubtitleWide">
        <item name="android:minHeight">@dimen/dp_9</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginTop">@dimen/dp_2</item>
    </style>

    <style name="HomeCheckoutCard" parent="HomeCheckoutCardWide">
        <item name="android:paddingStart">@dimen/dp_10</item>
        <item name="android:paddingEnd">@dimen/dp_10</item>
    </style>
</resources>
