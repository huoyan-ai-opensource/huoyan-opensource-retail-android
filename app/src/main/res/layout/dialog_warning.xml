<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_white_radius_5"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dp_26"
        android:paddingVertical="@dimen/dp_13"
        android:paddingTop="@dimen/dp_13"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/title"
                android:layout_alignBottom="@+id/title"
                android:layout_marginEnd="@dimen/dp_3"
                android:layout_toStartOf="@+id/title"
                android:src="@drawable/baseline_warning_24" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/dialog_title_hint"
                android:textColor="#293A51"
                android:textSize="@dimen/sp_10"
                android:textStyle="bold" />
        </RelativeLayout>

        <TextView
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            android:maxEms="18"
            android:text="@string/warning_forget_goods_msg"
            android:textColor="#586982"
            android:textSize="@dimen/sp_8" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_17"
            android:background="@color/white"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cancel"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_24"
                android:layout_weight="1"
                android:background="@drawable/btn_e1e3ea_radius_3"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/button_cancel"
                android:textColor="#293A51"
                android:textSize="@dimen/sp_8" />

            <TextView
                android:id="@+id/confirm"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_24"
                android:layout_marginStart="@dimen/dp_8"
                android:layout_weight="1"
                android:background="@drawable/btn_warn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/button_confirm"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_8" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>