<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/printerPaperLayout"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_26"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:layout_width="@dimen/dp_0"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="@string/printer_paper_width"
        android:textSize="@dimen/sp_9"
        android:textColor="#293A51"
        android:includeFontPadding="false"
        android:fontFamily="@font/retail_sans" />

    <TextView
        android:id="@+id/printerPaperWidth"
        android:layout_width="@dimen/dp_60"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textSize="@dimen/sp_9"
        android:textColor="#6E7C90"
        android:includeFontPadding="false"
        android:fontFamily="@font/retail_sans" />

    <TextView
        android:layout_width="@dimen/dp_12"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="@string/land_chevron"
        android:textSize="@dimen/sp_13"
        android:textColor="#6E7C90"
        android:includeFontPadding="false"
        android:fontFamily="@font/retail_sans" />
</LinearLayout>
