<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_white_radius_5" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/dp_12" android:focusableInTouchMode="true">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:text="@string/ws_settings"
            android:textColor="#293A51" android:textSize="@dimen/sp_10" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12" android:labelFor="@id/wsAddress"
            android:text="@string/ws_address_hint" android:textColor="#293A51" android:textSize="@dimen/sp_8" />
        <EditText android:id="@+id/wsAddress" style="@style/GoodsFormInput"
            android:layout_width="match_parent" android:layout_weight="0" android:layout_marginStart="0dp"
            android:layout_marginTop="@dimen/dp_6" android:minHeight="48dp"
            android:inputType="numberDecimal" android:digits="0123456789." android:maxLength="15"
            android:hint="@string/ws_address_hint" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6" android:text="@string/ws_address_help"
            android:textColor="#6B79A8" android:textSize="@dimen/sp_7" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10">
            <TextView android:id="@+id/wsProbe" style="@style/WsDialogAction"
                android:background="@drawable/btn_main_bg" android:textColor="@color/white"
                android:layout_marginEnd="@dimen/dp_4" android:text="@string/ws_test" />
            <TextView android:id="@+id/wsDiscover" style="@style/WsDialogAction"
                android:background="@drawable/btn_main_bg" android:textColor="@color/white"
                android:layout_marginStart="@dimen/dp_4" android:text="@string/ws_discover" />
        </LinearLayout>
        <TextView android:id="@+id/wsStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="@dimen/dp_16" android:layout_marginTop="@dimen/dp_8"
            android:textColor="#6B79A8" android:textSize="@dimen/sp_7" android:accessibilityLiveRegion="polite" />
        <ListView android:id="@+id/wsResults" android:layout_width="match_parent" android:layout_height="@dimen/dp_80"
            android:visibility="gone"
            android:divider="#EAEFF4" android:dividerHeight="@dimen/dp_0_5" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12">
            <TextView android:id="@+id/cancel" style="@style/WsDialogAction"
                android:layout_marginEnd="@dimen/dp_4" android:text="@string/button_cancel" />
            <TextView android:id="@+id/confirm" style="@style/WsDialogAction"
                android:layout_marginStart="@dimen/dp_4" android:background="@drawable/btn_main_bg"
                android:text="@string/button_confirm" android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
