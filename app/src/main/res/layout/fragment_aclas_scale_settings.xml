<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="95"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/dp_10"
        android:text="@string/settings_scale_title"
        android:textColor="#2A3547"
        android:textSize="@dimen/sp_8"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0_5"
        android:background="#EAEFF4" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="926"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_9"
            android:paddingVertical="@dimen/dp_8">

            <TextView
                android:layout_width="@dimen/dp_40"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:maxLines="2"
                android:text="@string/settings_system_weighing_module"
                android:textColor="#6B79A8"
                android:textSize="@dimen/sp_7" />

            <Switch
                android:id="@+id/weighingModule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_9"
                android:layout_marginEnd="@dimen/dp_68"
                android:background="@android:color/transparent"
                android:checked="false"
                android:thumb="@drawable/thumb_selector"
                android:track="@drawable/track_selector" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0_5"
            android:background="#EAEFF4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_9"
            android:paddingVertical="@dimen/dp_8">

            <TextView
                android:layout_width="@dimen/dp_40"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:maxLines="2"
                android:text="@string/settings_scale_brand"
                android:textColor="#6B79A8"
                android:textSize="@dimen/sp_7" />
            <LinearLayout
                android:layout_width="@dimen/dp_80"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_9"
                android:background="@drawable/bg_white_radius_dddddd_3"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingHorizontal="@dimen/dp_5"
                    android:paddingVertical="@dimen/dp_6"
                    android:text="@string/settings_scale_brand_aclas"
                    android:textColor="#2A3547"
                    android:textSize="@dimen/sp_7"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0_5"
            android:background="#EAEFF4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_9"
            android:paddingVertical="@dimen/dp_8">

            <TextView
                android:layout_width="@dimen/dp_40"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:maxLines="2"
                android:text="@string/settings_scale_select_port"
                android:textColor="#6B79A8"
                android:textSize="@dimen/sp_7" />

            <LinearLayout
                android:id="@+id/selectScalePort"
                android:layout_width="@dimen/dp_80"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_9"
                android:background="@drawable/bg_white_radius_dddddd_3"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/selectedScalePort"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingHorizontal="@dimen/dp_5"
                    android:paddingVertical="@dimen/dp_6"
                    android:text="@string/settings_scale_select_port"
                    android:textColor="#2A3547"
                    android:textSize="@dimen/sp_7"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="@dimen/dp_10"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/dp_5"
                    android:background="@drawable/land_icon_chevron_right" />
            </LinearLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_7"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/settings_scale_select_port_hint"
                android:textColor="#6B79A8"
                android:textSize="@dimen/sp_7" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0_5"
            android:background="#EAEFF4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_9"
            android:paddingVertical="@dimen/dp_8">

            <TextView
                android:layout_width="@dimen/dp_40"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:maxLines="2"
                android:text="@string/settings_scale_action"
                android:textColor="#6B79A8"
                android:textSize="@dimen/sp_7" />

            <TextView
                android:id="@+id/zeroScale"
                android:layout_width="@dimen/dp_40"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_9"
                android:background="@drawable/bg_white_radius_dddddd_3"
                android:gravity="center"
                android:paddingVertical="@dimen/dp_6"
                android:text="@string/settings_scale_zero"
                android:textColor="#2A3547"
                android:textSize="@dimen/sp_7"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tareScale"
                android:layout_width="@dimen/dp_40"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_5"
                android:background="@drawable/bg_white_radius_dddddd_3"
                android:gravity="center"
                android:paddingVertical="@dimen/dp_6"
                android:text="@string/settings_scale_tare"
                android:textColor="#2A3547"
                android:textSize="@dimen/sp_7"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_7"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/settings_scale_action_hint"
                android:textColor="#6B79A8"
                android:textSize="@dimen/sp_7" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0_5"
            android:background="#EAEFF4" />


        <TextView
            android:id="@+id/scaleTestStatus"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_60"
            android:layout_marginHorizontal="@dimen/dp_18"
            android:layout_marginTop="@dimen/dp_12"
            android:background="@drawable/bg_grey_radius_3"
            android:gravity="start|top"
            android:padding="@dimen/dp_10"
            android:text="@string/settings_scale_test_status_init"
            android:textColor="#2A3547"
            android:textSize="@dimen/sp_8" />

        <TextView
            android:id="@+id/testScalePort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp_18"
            android:background="@drawable/btn_main_bg"
            android:gravity="center"
            android:paddingHorizontal="@dimen/dp_15"
            android:paddingVertical="@dimen/dp_8"
            android:text="@string/settings_scale_test_btn"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_8" />
    </LinearLayout>
</LinearLayout>
