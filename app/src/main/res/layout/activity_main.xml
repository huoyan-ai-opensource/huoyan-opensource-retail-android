<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="#F2F4F8"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40"
        android:id="@+id/checkoutNavigation"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_8"
        android:paddingVertical="@dimen/dp_4"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_weight="1">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/default_shop_name"
                android:textSize="@dimen/sp_10"
                android:textColor="#293A51"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:id="@+id/shopName"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/checkoutClock"
                android:format12Hour="yyyy/MM/dd HH:mm:ss"
                android:format24Hour="yyyy/MM/dd HH:mm:ss"
                android:textSize="@dimen/sp_7"
                android:textColor="#637187"
                android:fontFamily="@font/retail_sans" />
        </LinearLayout>

        <include
            android:layout_width="@dimen/dp_212"
            android:layout_height="@dimen/dp_32"
            android:layout_marginTop="@dimen/dp_0"
            layout="@layout/checkout_weights" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:orientation="horizontal">

        <include
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:layout_weight="1"
            layout="@layout/checkout_camera" />

        <include
            android:layout_width="@dimen/dp_160"
            android:layout_height="match_parent"
            layout="@layout/checkout_results" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_42"
        android:id="@+id/checkoutFooter"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:paddingHorizontal="@dimen/dp_8"
        android:paddingVertical="@dimen/dp_6"
        android:background="#FFFFFF">

        <include
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_28"
            layout="@layout/checkout_actions"
            android:layout_weight="1" />

        <include
            android:layout_width="@dimen/dp_150"
            android:layout_height="@dimen/dp_30"
            android:layout_marginStart="@dimen/dp_8"
            layout="@layout/checkout_summary" />
    </LinearLayout>
</LinearLayout>