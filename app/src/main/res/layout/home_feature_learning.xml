<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeLearning"
    android:layout_width="@dimen/dp_0"
    android:layout_height="match_parent"
    android:layout_weight="1"
    style="@style/HomeFeatureCard"
    android:background="@drawable/home_feature_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <ImageView
        style="@style/HomeFeatureIcon"
        android:src="@drawable/land_icon_products" />

    <LinearLayout
        style="@style/HomeFeatureText"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/HomeFeatureTitle"
            android:text="@string/goods_management_title" />

        <TextView
            style="@style/HomeFeatureSubtitle"
            android:text="@string/goods_management_subtitle" />
    </LinearLayout>
</LinearLayout>
