<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F4F8">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/dp_16"
            android:paddingVertical="@dimen/dp_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dp_12"
                android:background="@drawable/land_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_17_5"
                    android:textSize="@dimen/sp_12"
                    android:textColor="#293A51"
                    android:includeFontPadding="false"
                    android:gravity="center_vertical"
                    android:text="@string/land_title_maintenance"
                    android:textStyle="bold"
                    android:fontFamily="@font/retail_sans" />

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_6" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:id="@+id/openAuthorization"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#293A51"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="@string/land_title_authorization"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:text="@string/land_view_license"
                        android:fontFamily="@font/retail_sans"
                        android:layout_weight="1.5" />

                    <TextView
                        android:layout_width="@dimen/dp_12"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_13"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:text="@string/land_chevron"
                        android:fontFamily="@font/retail_sans" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_6" />

                <include layout="@layout/item_sdk_permission_setting" />

                <Space
                    android:layout_width="@dimen/dp_1"
                    android:layout_height="@dimen/dp_6" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:id="@+id/handleInstall"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#293A51"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="@string/land_install_sdk"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:text="@string/land_download_sdk"
                        android:fontFamily="@font/retail_sans"
                        android:layout_weight="1.5" />

                    <TextView
                        android:layout_width="@dimen/dp_12"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_13"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:text="@string/land_chevron"
                        android:fontFamily="@font/retail_sans" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_6" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:id="@+id/handleClientInstall"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#293A51"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="@string/land_install_client"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:text="@string/land_download_client"
                        android:fontFamily="@font/retail_sans"
                        android:layout_weight="1.5" />

                    <TextView
                        android:layout_width="@dimen/dp_12"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_13"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:text="@string/land_chevron"
                        android:fontFamily="@font/retail_sans" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_6" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:id="@+id/languageSetting"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#293A51"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="@string/language_setting"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:id="@+id/languageValue"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:fontFamily="@font/retail_sans"
                        android:layout_weight="1.5" />

                    <TextView
                        android:layout_width="@dimen/dp_12"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_13"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:text="@string/land_chevron"
                        android:fontFamily="@font/retail_sans" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_6" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dp_6"
                    android:background="@drawable/land_field"
                    android:id="@+id/exitGuardCard">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_26"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="@dimen/dp_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/checkout_exit_guard"
                            android:textSize="@dimen/sp_9"
                            android:textColor="#293A51"
                            android:fontFamily="@font/retail_sans"
                            android:includeFontPadding="false"
                            android:labelFor="@id/exitPasswordEnabled" />

                        <cc.huoyan.retail.common.ui.LandscapeSwitch
                            android:layout_width="@dimen/dp_26"
                            android:layout_height="@dimen/dp_24"
                            android:id="@+id/exitPasswordEnabled"
                            android:contentDescription="@string/checkout_exit_guard"
                            android:showText="false"
                            android:thumb="@drawable/land_switch_thumb"
                            android:track="@drawable/land_switch_track"
                            android:splitTrack="false"
                            android:switchMinWidth="@dimen/dp_26"
                            android:thumbTint="@null"
                            android:trackTint="@null"
                            android:padding="@dimen/dp_0" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/checkout_exit_guard_hint"
                        android:textSize="@dimen/sp_8"
                        android:textColor="#6E7C90"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:layout_marginTop="@dimen/dp_4"
                        android:layout_marginBottom="@dimen/dp_4" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_24"
                        android:text="@string/checkout_password_setting"
                        android:textSize="@dimen/sp_8"
                        android:textColor="#3F3EED"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:id="@+id/setExitPassword"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40"
        android:gravity="end|center_vertical"
        android:paddingHorizontal="@dimen/dp_16"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="@dimen/dp_100"
            android:layout_height="@dimen/dp_26"
            android:id="@+id/handleQuit"
            android:textSize="@dimen/sp_9"
            android:textColor="#D7493D"
            android:includeFontPadding="false"
            android:gravity="center"
            android:background="@drawable/land_danger"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/settings_system_quit_app"
            android:textStyle="bold"
            android:fontFamily="@font/retail_sans" />
    </LinearLayout>
</LinearLayout>
