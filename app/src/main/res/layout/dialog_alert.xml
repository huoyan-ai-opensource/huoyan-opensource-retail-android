<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/TRANSPARENT"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_white_radius_5"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dp_5"
        android:paddingTop="@dimen/dp_11"
        android:paddingBottom="@dimen/dp_8">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_10"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="@dimen/dp_200"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_6"
            android:layout_marginTop="@dimen/dp_14"
            android:textColor="#293A51"
            android:textSize="@dimen/sp_9" />

        <CheckBox
            android:id="@+id/learningGuideDontShowAgain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_6"
            android:layout_marginTop="@dimen/dp_8"
            android:minHeight="@dimen/dp_24"
            android:buttonTint="#3F3EED"
            android:text="@string/learning_guide_dont_show_again"
            android:textColor="#66758B"
            android:textSize="@dimen/sp_7"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/bottomLayout"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="@dimen/dp_6"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_14"
            android:background="@color/white"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cancel"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_24"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_weight="1"
                android:background="@drawable/btn_white_stroke_979797_radius_3"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="@dimen/dp_8"
                android:text="@string/button_cancel"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_8" />

            <TextView
                android:id="@+id/confirm"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_24"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginStart="@dimen/dp_5"
                android:layout_weight="1"
                android:background="@drawable/btn_main_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="@dimen/dp_8"
                android:text="@string/button_ok"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_8" />

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
