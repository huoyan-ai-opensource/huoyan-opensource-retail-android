<?xml version="1.0" encoding="utf-8"?>
<!-- 改品与学习选择共用三层商品卡；外层留白构成宫格间距。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <FrameLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="100dp"
        android:background="@drawable/goods_choice_background"
        android:foreground="@drawable/goods_choice_border">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="100dp"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/pluName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:textColor="#293A51"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/plu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:gravity="center_vertical"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:textColor="#6E7C90"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:gravity="center_vertical"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:textColor="#3F3EED"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
        <!-- 角标由卡片圆角裁切，边框前景最后绘制，避免斜带遮挡描边。 -->
        <FrameLayout
            android:id="@+id/similarBadge"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:visibility="gone"
            android:contentDescription="@string/goods_similar_description">
            <TextView
                android:layout_width="52dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:translationX="3dp"
                android:translationY="-3dp"
                android:rotation="45"
                android:gravity="center"
                android:background="@drawable/goods_similar_badge"
                android:text="@string/goods_similar_badge"
                android:textColor="#B84E00"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
