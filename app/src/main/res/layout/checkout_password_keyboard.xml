<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:minHeight="@dimen/dp_108">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:orientation="horizontal"
        android:layout_weight="1"
        android:minHeight="@dimen/dp_24">

        <TextView
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="1"
            android:textSize="@dimen/sp_12"
            android:textColor="#293A51"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:id="@+id/num1"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/land_field"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="2"
            android:textSize="@dimen/sp_12"
            android:textColor="#293A51"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:id="@+id/num2"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/land_field"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="@dimen/dp_5" />

        <TextView
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="3"
            android:textSize="@dimen/sp_12"
            android:textColor="#293A51"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:id="@+id/num3"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/land_field"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="@dimen/dp_5" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_weight="1"
        android:minHeight="@dimen/dp_24">

        <TextView
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="4"
            android:textSize="@dimen/sp_12"
            android:textColor="#293A51"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:id="@+id/num4"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/land_field"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="5"
            android:textSize="@dimen/sp_12"
            android:textColor="#293A51"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:id="@+id/num5"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/land_field"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="@dimen/dp_5" />

        <TextView
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="6"
            android:textSize="@dimen/sp_12"
            android:textColor="#293A51"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:id="@+id/num6"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/land_field"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="@dimen/dp_5" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_weight="1"
        android:minHeight="@dimen/dp_24">

        <TextView
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="7"
            android:textSize="@dimen/sp_12"
            android:textColor="#293A51"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:id="@+id/num7"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/land_field"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="8"
            android:textSize="@dimen/sp_12"
            android:textColor="#293A51"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:id="@+id/num8"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/land_field"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="@dimen/dp_5" />

        <TextView
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="9"
            android:textSize="@dimen/sp_12"
            android:textColor="#293A51"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:id="@+id/num9"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/land_field"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="@dimen/dp_5" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_weight="1"
        android:minHeight="@dimen/dp_24">

        <TextView
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="@string/checkout_clear"
            android:textSize="@dimen/sp_9"
            android:textColor="@color/white"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:id="@+id/dot"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/keypad_clear"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="0"
            android:textSize="@dimen/sp_12"
            android:textColor="#293A51"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:id="@+id/num0"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/land_field"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="@dimen/dp_5" />

        <TextView
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="⌫"
            android:textSize="@dimen/sp_9"
            android:textColor="@android:color/black"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:id="@+id/backspace"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/keypad_backspace"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="@dimen/dp_5"
            android:contentDescription="@string/checkout_backspace" />
    </LinearLayout>
</LinearLayout>
