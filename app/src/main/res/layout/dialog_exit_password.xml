<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#70142033"
    android:padding="@dimen/dp_10">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:layout_width="@dimen/dp_380"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dp_12"
                android:background="@drawable/land_card"
                android:id="@+id/checkoutDialogCard">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/checkout_password_setup_title"
                    android:textSize="@dimen/sp_12"
                    android:textColor="#293A51"
                    android:fontFamily="@font/retail_sans"
                    android:includeFontPadding="false"
                    android:id="@+id/passwordTitle"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/dp_8"
                    android:minHeight="@dimen/dp_17_5" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/dp_6">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/checkout_password_purpose"
                            android:textSize="@dimen/sp_8"
                            android:textColor="#6E7C90"
                            android:fontFamily="@font/retail_sans"
                            android:includeFontPadding="false"
                            android:id="@+id/passwordPurpose"
                            android:layout_marginBottom="@dimen/dp_6" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/checkout_new_password"
                            android:textSize="@dimen/sp_8"
                            android:textColor="#293A51"
                            android:fontFamily="@font/retail_sans"
                            android:includeFontPadding="false"
                            android:id="@+id/passwordLabel"
                            android:layout_marginBottom="@dimen/dp_6"
                            android:minHeight="@dimen/dp_11_5" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_26"
                            android:text="@string/checkout_password"
                            android:textSize="@dimen/sp_9"
                            android:textColor="#6E7C90"
                            android:fontFamily="@font/retail_sans"
                            android:includeFontPadding="false"
                            android:id="@+id/passwordInput"
                            android:background="@drawable/bg_password_field"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="@dimen/dp_8"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/checkout_confirm_password"
                            android:textSize="@dimen/sp_8"
                            android:textColor="#293A51"
                            android:fontFamily="@font/retail_sans"
                            android:includeFontPadding="false"
                            android:id="@+id/passwordRepeatLabel"
                            android:layout_marginTop="@dimen/dp_6"
                            android:layout_marginBottom="@dimen/dp_6"
                            android:minHeight="@dimen/dp_11_5" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_26"
                            android:text="@string/checkout_password_repeat"
                            android:textSize="@dimen/sp_9"
                            android:textColor="#6E7C90"
                            android:fontFamily="@font/retail_sans"
                            android:includeFontPadding="false"
                            android:id="@+id/passwordRepeat"
                            android:background="@drawable/bg_password_field"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="@dimen/dp_8"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <include
                        android:id="@+id/passwordKeyboard"
                        layout="@layout/checkout_password_keyboard"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/dp_8">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="@dimen/dp_26"
                        android:text="@string/button_cancel"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#3F3EED"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:id="@+id/closeDialog"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/land_soft" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="@dimen/dp_26"
                        android:text="@string/checkout_save_password"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:id="@+id/confirmPassword"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/land_primary"
                        android:layout_marginStart="@dimen/dp_6" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
