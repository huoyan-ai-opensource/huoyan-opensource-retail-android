<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:layout_marginStart="-12dp" android:layout_marginEnd="-12dp" android:paddingStart="12dp" android:paddingEnd="12dp"
    android:clipToPadding="false" android:clipChildren="false">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="32dp" android:gravity="center_vertical"
        android:text="@string/recognition_sensitivity_title" android:textSize="20sp" android:textColor="#293A51"
        android:includeFontPadding="false" android:textStyle="bold" android:fontFamily="@font/retail_sans" />
    <SeekBar android:id="@+id/recognitionSensitivity" android:layout_width="match_parent" android:layout_height="48dp"
        android:max="4" android:progress="2" android:paddingStart="12dp" android:paddingEnd="12dp"
        android:layout_marginStart="-12dp" android:layout_marginEnd="-12dp"
        android:paddingTop="0dp" android:paddingBottom="0dp"
        android:progressDrawable="@drawable/sensitivity_track" android:progressTint="@null" android:progressBackgroundTint="@null"
        android:thumb="@drawable/sensitivity_thumb" android:thumbTint="@null" android:thumbOffset="12dp"
        android:tickMark="@drawable/sensitivity_tick" android:tickMarkTint="@null"
        android:background="@null" android:minHeight="4dp" android:maxHeight="4dp" android:splitTrack="false" />
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/recognitionSensitivityLabels"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="24dp"
        android:importantForAccessibility="noHideDescendants">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
            android:textSize="15sp" android:textColor="@color/sensitivity_label" android:includeFontPadding="false" android:fontFamily="@font/retail_sans" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/sensitivityGuide2" app:layout_constraintEnd_toEndOf="@id/sensitivityGuide2" app:layout_constraintTop_toTopOf="parent"
            android:textSize="15sp" android:textColor="@color/sensitivity_label" android:includeFontPadding="false" android:fontFamily="@font/retail_sans" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/sensitivityGuide3" app:layout_constraintEnd_toEndOf="@id/sensitivityGuide3" app:layout_constraintTop_toTopOf="parent"
            android:textSize="15sp" android:textColor="@color/sensitivity_label" android:includeFontPadding="false" android:fontFamily="@font/retail_sans" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/sensitivityGuide4" app:layout_constraintEnd_toEndOf="@id/sensitivityGuide4" app:layout_constraintTop_toTopOf="parent"
            android:textSize="15sp" android:textColor="@color/sensitivity_label" android:includeFontPadding="false" android:fontFamily="@font/retail_sans" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent"
            android:textSize="15sp" android:textColor="@color/sensitivity_label" android:includeFontPadding="false" android:fontFamily="@font/retail_sans" />
        <androidx.constraintlayout.widget.Guideline android:id="@+id/sensitivityGuide2"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
            app:layout_constraintGuide_percent="0.25" />
        <androidx.constraintlayout.widget.Guideline android:id="@+id/sensitivityGuide3"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />
        <androidx.constraintlayout.widget.Guideline android:id="@+id/sensitivityGuide4"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
            app:layout_constraintGuide_percent="0.75" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/recognition_sensitivity_hint" android:textSize="15sp" android:textColor="#6E7C90"
        android:includeFontPadding="false" android:lineSpacingExtra="3dp" android:fontFamily="@font/retail_sans" />
</LinearLayout>
