<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginStart="@dimen/dp_neg_6"
    android:layout_marginEnd="@dimen/dp_neg_6"
    android:paddingStart="@dimen/dp_6"
    android:paddingEnd="@dimen/dp_6"
    android:clipToPadding="false"
    android:clipChildren="false">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp_16"
        android:gravity="center_vertical"
        android:text="@string/recognition_sensitivity_title"
        android:textSize="@dimen/sp_10"
        android:textColor="#293A51"
        android:includeFontPadding="false"
        android:textStyle="bold"
        android:fontFamily="@font/retail_sans" />

    <SeekBar
        android:id="@+id/recognitionSensitivity"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_24"
        android:max="4"
        android:progress="2"
        android:paddingStart="@dimen/dp_6"
        android:paddingEnd="@dimen/dp_6"
        android:layout_marginStart="@dimen/dp_neg_6"
        android:layout_marginEnd="@dimen/dp_neg_6"
        android:paddingTop="@dimen/dp_0"
        android:paddingBottom="@dimen/dp_0"
        android:progressDrawable="@drawable/sensitivity_track"
        android:progressTint="@null"
        android:progressBackgroundTint="@null"
        android:thumb="@drawable/sensitivity_thumb"
        android:thumbTint="@null"
        android:thumbOffset="@dimen/dp_6"
        android:tickMark="@drawable/sensitivity_tick"
        android:tickMarkTint="@null"
        android:background="@null"
        android:minHeight="@dimen/dp_2"
        android:maxHeight="@dimen/dp_2"
        android:splitTrack="false" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/recognitionSensitivityLabels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp_12"
        android:importantForAccessibility="noHideDescendants">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:textSize="@dimen/sp_7_5"
            android:textColor="@color/sensitivity_label"
            android:includeFontPadding="false"
            android:fontFamily="@font/retail_sans" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/sensitivityGuide2"
            app:layout_constraintEnd_toEndOf="@id/sensitivityGuide2"
            app:layout_constraintTop_toTopOf="parent"
            android:textSize="@dimen/sp_7_5"
            android:textColor="@color/sensitivity_label"
            android:includeFontPadding="false"
            android:fontFamily="@font/retail_sans" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/sensitivityGuide3"
            app:layout_constraintEnd_toEndOf="@id/sensitivityGuide3"
            app:layout_constraintTop_toTopOf="parent"
            android:textSize="@dimen/sp_7_5"
            android:textColor="@color/sensitivity_label"
            android:includeFontPadding="false"
            android:fontFamily="@font/retail_sans" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/sensitivityGuide4"
            app:layout_constraintEnd_toEndOf="@id/sensitivityGuide4"
            app:layout_constraintTop_toTopOf="parent"
            android:textSize="@dimen/sp_7_5"
            android:textColor="@color/sensitivity_label"
            android:includeFontPadding="false"
            android:fontFamily="@font/retail_sans" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:textSize="@dimen/sp_7_5"
            android:textColor="@color/sensitivity_label"
            android:includeFontPadding="false"
            android:fontFamily="@font/retail_sans" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/sensitivityGuide2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.25" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/sensitivityGuide3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/sensitivityGuide4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.75" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recognition_sensitivity_hint"
        android:textSize="@dimen/sp_7_5"
        android:textColor="#6E7C90"
        android:includeFontPadding="false"
        android:lineSpacingExtra="@dimen/dp_1_5"
        android:fontFamily="@font/retail_sans" />
</LinearLayout>
