<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_32"
    android:id="@+id/countWeightTypeLayout"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="@dimen/dp_0"
        android:layout_height="match_parent"
        android:id="@+id/netWeightCard"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="@dimen/dp_5"
        android:background="@drawable/bg_checkout_net"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginStart="@dimen/dp_0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <View
                android:layout_width="@dimen/dp_3"
                android:layout_height="@dimen/dp_3"
                android:id="@+id/connectLine"
                android:background="@drawable/bg_red_round"
                android:layout_marginEnd="@dimen/dp_2" />

            <TextView
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:text="@string/checkout_net"
                android:textSize="@dimen/sp_6"
                android:textColor="#637187"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="kg"
                android:textSize="@dimen/sp_5_5"
                android:textColor="#637187"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="@dimen/sp_12_5"
            android:textColor="#293A51"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:id="@+id/weightTv"
            android:textStyle="bold"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="@dimen/sp_8"
            android:autoSizeMaxTextSize="@dimen/sp_12_5"
            android:autoSizeStepGranularity="@dimen/sp_0_5" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="@dimen/dp_0"
        android:layout_height="match_parent"
        android:id="@+id/tareWeightCard"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="@dimen/dp_5"
        android:background="@drawable/bg_checkout_tare"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginStart="@dimen/dp_4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:text="@string/checkout_tare"
                android:textSize="@dimen/sp_6"
                android:textColor="#637187"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="kg"
                android:textSize="@dimen/sp_5_5"
                android:textColor="#637187"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="@dimen/sp_12_5"
            android:textColor="#293A51"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:id="@+id/tareWeight"
            android:textStyle="bold"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="@dimen/sp_8"
            android:autoSizeMaxTextSize="@dimen/sp_12_5"
            android:autoSizeStepGranularity="@dimen/sp_0_5" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="@dimen/dp_0"
        android:layout_height="match_parent"
        android:id="@+id/grossWeightCard"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="@dimen/dp_5"
        android:background="@drawable/bg_checkout_gross"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginStart="@dimen/dp_4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:text="@string/checkout_gross"
                android:textSize="@dimen/sp_6"
                android:textColor="#637187"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="kg"
                android:textSize="@dimen/sp_5_5"
                android:textColor="#637187"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="@dimen/sp_12_5"
            android:textColor="#293A51"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:id="@+id/grossWeight"
            android:textStyle="bold"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="@dimen/sp_8"
            android:autoSizeMaxTextSize="@dimen/sp_12_5"
            android:autoSizeStepGranularity="@dimen/sp_0_5" />
    </LinearLayout>
</LinearLayout>