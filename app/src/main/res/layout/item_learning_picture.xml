<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1">

        <cc.huoyan.retail.common.ui.RoundMaskFrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/dp_4">

            <ImageView
                android:id="@+id/img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#D8D8D8" />
        </cc.huoyan.retail.common.ui.RoundMaskFrameLayout>

        <TextView
            android:id="@+id/newPicture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/dp_4"
            android:layout_marginBottom="@dimen/dp_4"
            android:paddingHorizontal="@dimen/dp_2"
            android:paddingVertical="@dimen/dp_1"
            android:text="@string/learning_new"
            android:textSize="@dimen/sp_4_5"
            android:background="#3F3EED"
            android:textColor="#FFFFFF" />

        <ImageView
            android:id="@+id/del"
            android:layout_width="@dimen/dp_15"
            android:layout_height="@dimen/dp_15"
            android:layout_alignParentEnd="true"
            android:paddingStart="@dimen/dp_4"
            android:paddingTop="@dimen/dp_1"
            android:paddingEnd="@dimen/dp_1"
            android:paddingBottom="@dimen/dp_4"
            android:src="@mipmap/ic_delete"
            android:contentDescription="@string/learning_remove_image" />
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>