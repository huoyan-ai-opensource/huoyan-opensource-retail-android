<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/cameraPreviewArea"
    android:background="#283342">

    <cc.huoyan.retail.device.camera.AutoFitTextureView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <cc.huoyan.retail.checkout.MainDrawView
        android:id="@+id/drawView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <cc.huoyan.retail.checkout.RecognizeResultPreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:background="@drawable/bg_grey_radius_2"
        android:id="@+id/recognizeStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_marginTop="@dimen/dp_8"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/dp_5"
        android:paddingVertical="@dimen/dp_3">

        <ImageView
            android:id="@+id/recognizeIcon"
            android:layout_width="@dimen/dp_7"
            android:layout_height="@dimen/dp_7"
            android:layout_marginEnd="@dimen/dp_5"
            android:background="@drawable/bg_red_round" />

        <TextView
            android:id="@+id/recognizeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_sdk_disconnected"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/sp_7"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/version"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_24"
        android:layout_gravity="end|bottom"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="@dimen/dp_36"
        android:minHeight="@dimen/dp_24"
        android:text="@string/version_placeholder"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/sp_7"
        android:fontFamily="@font/retail_sans"
        android:includeFontPadding="false"
        android:paddingHorizontal="@dimen/dp_8"
        android:background="@android:color/transparent" />
</FrameLayout>