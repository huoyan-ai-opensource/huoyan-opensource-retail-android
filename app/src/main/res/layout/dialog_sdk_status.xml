<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#70142033" android:padding="20dp">
  <cc.huoyan.retail.common.ui.BoundedDialogLayout android:layout_width="640dp" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:background="@drawable/land_card" android:id="@+id/boundedCheckoutDialog" android:layout_gravity="center">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <TextView android:layout_width="0dp" android:layout_height="38dp" android:text="@string/checkout_sdk_title" android:textSize="24sp" android:textColor="#293A51" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:layout_weight="1" android:gravity="center_vertical" android:textStyle="bold" />
      <TextView android:layout_width="48dp" android:layout_height="48dp" android:text="×" android:textSize="26sp" android:textColor="#6E7C90" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/closeSdkIcon" android:gravity="center" android:clickable="true" android:focusable="true" android:contentDescription="@string/checkout_close" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="false">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="57dp" android:text="@string/checkout_sdk_unavailable" android:textSize="20sp" android:textColor="#293A51" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/sdkHealth" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:background="@drawable/land_field" android:textStyle="bold" android:layout_marginTop="14dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:minHeight="30dp" android:gravity="center_vertical" android:layout_marginTop="14dp">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/checkout_sdk_connection" android:textSize="16sp" android:textColor="#6E7C90" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" />
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="—" android:textSize="16sp" android:textColor="#293A51" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/sdkConnection" android:layout_weight="1" android:gravity="end" android:layout_marginStart="16dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:minHeight="30dp" android:gravity="center_vertical" android:layout_marginTop="14dp">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/checkout_sdk_authorization" android:textSize="16sp" android:textColor="#6E7C90" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" />
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="—" android:textSize="16sp" android:textColor="#293A51" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/sdkAuthorization" android:layout_weight="1" android:gravity="end" android:layout_marginStart="16dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:minHeight="30dp" android:gravity="center_vertical" android:layout_marginTop="14dp">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/checkout_sdk_initialization" android:textSize="16sp" android:textColor="#6E7C90" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" />
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="—" android:textSize="16sp" android:textColor="#293A51" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/sdkInitialization" android:layout_weight="1" android:gravity="end" android:layout_marginStart="16dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:minHeight="30dp" android:gravity="center_vertical" android:layout_marginTop="14dp">
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/checkout_sdk_checked_at" android:textSize="16sp" android:textColor="#6E7C90" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" />
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="—" android:textSize="16sp" android:textColor="#293A51" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/sdkCheckedAt" android:layout_weight="1" android:gravity="end" android:layout_marginStart="16dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/land_field" android:padding="16dp" android:layout_marginTop="14dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/checkout_sdk_errors" android:textSize="16sp" android:textColor="#293A51" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:textStyle="bold" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textSize="16sp" android:textColor="#6E7C90" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/sdkDetails" android:textIsSelectable="true" android:layout_marginTop="8dp" android:lineSpacingExtra="4dp" />
        </LinearLayout>
      </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp">
      <TextView android:layout_width="0dp" android:layout_height="52dp" android:text="@string/checkout_close" android:textSize="18sp" android:textColor="#3F3EED" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/closeDialog" android:layout_weight="1" android:gravity="center" android:clickable="true" android:focusable="true" android:background="@drawable/land_soft" />
      <TextView android:layout_width="0dp" android:layout_height="52dp" android:text="@string/checkout_sdk_refresh" android:textSize="18sp" android:textColor="#FFFFFF" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/refreshSdk" android:layout_weight="1" android:gravity="center" android:clickable="true" android:focusable="true" android:background="@drawable/land_primary" android:layout_marginStart="12dp" />
    </LinearLayout>
  </cc.huoyan.retail.common.ui.BoundedDialogLayout>
</FrameLayout>
