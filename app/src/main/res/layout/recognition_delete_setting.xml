<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp_42"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp_10"
            android:textColor="#293A51"
            android:includeFontPadding="false"
            android:text="@string/settings_delete_recognition_result"
            android:textStyle="bold"
            android:fontFamily="@font/retail_sans" />

        <Space
            android:layout_width="@dimen/dp_0_5"
            android:layout_height="@dimen/dp_3" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp_7_5"
            android:textColor="#6E7C90"
            android:includeFontPadding="false"
            android:lineSpacingExtra="@dimen/dp_1_5"
            android:text="@string/delete_recognition_result_hint"
            android:fontFamily="@font/retail_sans" />
    </LinearLayout>

    <cc.huoyan.retail.common.ui.LandscapeSwitch
        android:layout_width="@dimen/dp_26"
        android:layout_height="@dimen/dp_24"
        android:id="@+id/deleteRecognitionResult"
        android:contentDescription="@string/settings_delete_recognition_result"
        android:showText="false"
        android:thumb="@drawable/land_switch_thumb"
        android:track="@drawable/land_switch_track"
        android:splitTrack="false"
        android:switchMinWidth="@dimen/dp_26"
        android:thumbTint="@null"
        android:trackTint="@null"
        android:padding="@dimen/dp_0" />
</LinearLayout>
