<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/dp_12"
    android:background="@drawable/land_card">

    <TextView
        android:id="@+id/selectTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp_16"
        android:gravity="center_vertical"
        android:textSize="@dimen/sp_12"
        android:textStyle="bold"
        android:textColor="#293A51"
        android:fontFamily="@font/retail_sans"
        android:includeFontPadding="false"
        android:accessibilityHeading="true" />

    <TextView
        android:id="@+id/selectSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:visibility="gone"
        android:textSize="@dimen/sp_8"
        android:textColor="#6E7C90"
        android:fontFamily="@font/retail_sans"
        android:includeFontPadding="false" />

    <ListView
        android:id="@+id/selectOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:choiceMode="singleChoice"
        android:divider="@android:color/transparent"
        android:dividerHeight="@dimen/dp_4"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/selectEmpty"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_64"
        android:gravity="center"
        android:visibility="gone"
        android:text="@string/select_option_empty"
        android:textSize="@dimen/sp_9"
        android:textColor="#6E7C90"
        android:fontFamily="@font/retail_sans" />

    <TextView
        android:id="@+id/selectCancel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_26"
        android:layout_marginTop="@dimen/dp_10"
        android:gravity="center"
        android:text="@string/button_cancel"
        android:textSize="@dimen/sp_9"
        android:textStyle="bold"
        android:textColor="#293A51"
        android:fontFamily="@font/retail_sans"
        android:background="@drawable/land_field"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
