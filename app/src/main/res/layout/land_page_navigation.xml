<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_32"
    android:background="#FFFFFF">

    <TextView
        style="@style/PageNavigationTitle"
        android:textSize="@dimen/sp_12"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/navTitle"
        android:gravity="center"
        android:paddingHorizontal="@dimen/dp_72" />

    <TextView
        android:layout_width="@dimen/dp_56"
        android:layout_height="@dimen/dp_24"
        android:id="@+id/navBack"
        android:textSize="@dimen/sp_8"
        android:textColor="#3F3EED"
        android:includeFontPadding="false"
        android:gravity="center"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_marginTop="@dimen/dp_4"
        android:background="@drawable/land_soft"
        android:drawableStart="@drawable/land_icon_arrow_left"
        android:paddingHorizontal="@dimen/dp_5"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/home_back"
        android:fontFamily="@font/retail_sans" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0_5"
        android:layout_gravity="bottom"
        android:background="#E7EBF1" />
</FrameLayout>