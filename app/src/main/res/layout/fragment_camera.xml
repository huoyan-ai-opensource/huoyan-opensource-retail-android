<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="95"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/dp_10"
        android:text="@string/settings_camera_title"
        android:textColor="#2A3547"
        android:textSize="@dimen/sp_8"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0_5"
        android:background="#EAEFF4" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="926"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_9"
            android:paddingVertical="@dimen/dp_8">

            <TextView
                android:layout_width="@dimen/dp_40"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:maxLines="2"
                android:text="@string/settings_camera_type"
                android:textColor="#6B79A8"
                android:textSize="@dimen/sp_7" />

            <LinearLayout
                android:id="@+id/cameraTypeLayout"
                android:layout_width="@dimen/dp_80"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_9"
                android:background="@drawable/bg_white_radius_dddddd_3"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/cameraType"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingHorizontal="@dimen/dp_5"
                    android:paddingVertical="@dimen/dp_6"
                    android:text="@string/camera_type_uvc"
                    android:textColor="#2A3547"
                    android:textSize="@dimen/sp_7"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="@dimen/dp_10"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/dp_5"
                    android:background="@drawable/land_icon_chevron_right" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_7"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/settings_camera_select_hint"
                android:textColor="#6B79A8"
                android:textSize="@dimen/sp_7" />

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_9"
            android:paddingVertical="@dimen/dp_8">

            <TextView
                android:layout_width="@dimen/dp_40"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:maxLines="2"
                android:text="@string/settings_camera_select"
                android:textColor="#6B79A8"
                android:textSize="@dimen/sp_7" />

            <LinearLayout
                android:id="@+id/cameraNameLayout"
                android:layout_width="@dimen/dp_80"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_9"
                android:background="@drawable/bg_white_radius_dddddd_3"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/cameraName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingHorizontal="@dimen/dp_5"
                    android:paddingVertical="@dimen/dp_6"
                    android:text="@string/settings_camera_select"
                    android:textColor="#2A3547"
                    android:textSize="@dimen/sp_7"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="@dimen/dp_10"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/dp_5"
                    android:background="@drawable/land_icon_chevron_right" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_7"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/settings_camera_select_hint"
                android:textColor="#6B79A8"
                android:textSize="@dimen/sp_7" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0_5"
            android:background="#EAEFF4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_9"
            android:paddingVertical="@dimen/dp_8">

            <TextView
                android:layout_width="@dimen/dp_40"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:maxLines="2"
                android:text="@string/settings_camera_resolution_label"
                android:textColor="#6B79A8"
                android:textSize="@dimen/sp_7" />

            <LinearLayout
                android:id="@+id/cameraResolutionLayout"
                android:layout_width="@dimen/dp_80"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_9"
                android:background="@drawable/bg_white_radius_dddddd_3"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/cameraResolution"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingHorizontal="@dimen/dp_5"
                    android:paddingVertical="@dimen/dp_6"
                    android:text="@string/settings_camera_resolution_pick"
                    android:textColor="#2A3547"
                    android:textSize="@dimen/sp_7"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="@dimen/dp_10"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/dp_5"
                    android:background="@drawable/land_icon_chevron_right" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_7"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/settings_camera_resolution_hint"
                android:textColor="#6B79A8"
                android:textSize="@dimen/sp_7" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0_5"
            android:background="#EAEFF4"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_47"
            android:layout_marginStart="@dimen/dp_8"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_9"
            android:visibility="gone">

            <TextView
                android:layout_width="@dimen/dp_40"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:maxLines="2"
                android:text="@string/settings_camera_mirror"
                android:textColor="#6B79A8"
                android:textSize="@dimen/sp_7" />

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/cameraRotate"
                    android:layout_width="@dimen/dp_90"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_9"
                    android:background="@drawable/bg_white_radius_dddddd_3"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/dp_5"
                    android:paddingVertical="@dimen/dp_9"
                    android:textColor="#2A3547"
                    android:textSize="@dimen/sp_7"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="@dimen/dp_10"
                    android:layout_height="wrap_content"
                    android:layout_alignEnd="@+id/cameraRotate"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/dp_8"
                    android:background="@drawable/land_icon_chevron_right" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_7"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/settings_camera_mirror_hint"
                android:textColor="#6B79A8"
                android:textSize="@dimen/sp_7" />

        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0_5"
            android:background="#EAEFF4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_marginTop="@dimen/dp_6"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_9">

            <TextView
                android:layout_width="@dimen/dp_40"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:maxLines="2"
                android:text="@string/settings_camera_preview"
                android:textColor="#6B79A8"
                android:textSize="@dimen/sp_7" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/dp_10"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="@dimen/dp_350"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <cc.huoyan.retail.common.ui.RoundMaskFrameLayout
                            android:id="@+id/roundLayout"
                            android:layout_width="@dimen/dp_350"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_e6e4e4_radius_5">

                            <TextView
                                android:id="@+id/imageViewText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:layout_gravity="center"
                                android:text="@string/settings_camera_preview_hint"
                                android:textColor="#555555"
                                android:textSize="@dimen/sp_7"
                                android:textStyle="bold" />

                            <cc.huoyan.retail.device.camera.AutoFitTextureView
                                android:id="@+id/surfaceView"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_centerInParent="true"
                                android:layout_alignParentTop="true"
                                android:layout_alignParentBottom="true"
                                android:layout_gravity="center"
                                android:visibility="gone" />

                            <cc.huoyan.retail.device.camera.ResizableDashedBoxView
                                android:id="@+id/boxView"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_alignStart="@+id/surfaceView"
                                android:layout_alignTop="@+id/surfaceView"
                                android:layout_alignEnd="@+id/surfaceView"
                                android:layout_alignBottom="@+id/surfaceView"
                                android:background="@color/TRANSPARENT" />

                        </cc.huoyan.retail.common.ui.RoundMaskFrameLayout>
                    </LinearLayout>

                </RelativeLayout>


            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</LinearLayout>