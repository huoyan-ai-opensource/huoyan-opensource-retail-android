<?xml version='1.0' encoding='utf-8'?>
<cc.huoyan.retail.common.ui.BoundedDialogLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="@dimen/dp_12"
    android:paddingRight="@dimen/dp_12"
    android:paddingTop="@dimen/dp_6"
    android:paddingBottom="@dimen/dp_6"
    android:background="@drawable/land_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_24"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp_12"
            android:textColor="#293A51"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:text="@string/cloud_title"
            android:layout_weight="1"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_24"
            android:textSize="@dimen/sp_8"
            android:textColor="#3F3EED"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:text="@string/button_close"
            android:id="@+id/close"
            android:gravity="center"
            android:paddingHorizontal="@dimen/dp_8"
            android:background="@drawable/land_soft"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/cloudMarketing">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp_142"
                    android:layout_marginTop="@dimen/dp_4"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:id="@+id/cloudMarketingDetails">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false">

                            <ImageView
                                android:layout_width="@dimen/dp_12"
                                android:layout_height="@dimen/dp_12"
                                android:src="@drawable/land_icon_store"
                                android:importantForAccessibility="no" />

                            <LinearLayout
                                android:layout_width="@dimen/dp_0"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/dp_6">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/sp_9"
                                    android:textColor="#293A51"
                                    android:fontFamily="@font/retail_sans"
                                    android:includeFontPadding="false"
                                    android:text="@string/cloud_benefit_title_1" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/sp_7"
                                    android:textColor="#6E7C90"
                                    android:fontFamily="@font/retail_sans"
                                    android:includeFontPadding="false"
                                    android:text="@string/cloud_benefit_body_1"
                                    android:lineSpacingMultiplier="1.5"
                                    android:layout_marginTop="@dimen/dp_2" />
                            </LinearLayout>
                        </LinearLayout>

                        <Space
                            android:layout_width="@dimen/dp_0_5"
                            android:layout_height="@dimen/dp_0"
                            android:layout_weight="1"
                            android:minHeight="@dimen/dp_5" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false">

                            <ImageView
                                android:layout_width="@dimen/dp_12"
                                android:layout_height="@dimen/dp_12"
                                android:src="@drawable/land_icon_store"
                                android:importantForAccessibility="no" />

                            <LinearLayout
                                android:layout_width="@dimen/dp_0"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/dp_6">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/sp_9"
                                    android:textColor="#293A51"
                                    android:fontFamily="@font/retail_sans"
                                    android:includeFontPadding="false"
                                    android:text="@string/cloud_benefit_title_2" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/sp_7"
                                    android:textColor="#6E7C90"
                                    android:fontFamily="@font/retail_sans"
                                    android:includeFontPadding="false"
                                    android:text="@string/cloud_benefit_body_2"
                                    android:lineSpacingMultiplier="1.5"
                                    android:layout_marginTop="@dimen/dp_2" />
                            </LinearLayout>
                        </LinearLayout>

                        <Space
                            android:layout_width="@dimen/dp_0_5"
                            android:layout_height="@dimen/dp_0"
                            android:layout_weight="1"
                            android:minHeight="@dimen/dp_5" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false">

                            <ImageView
                                android:layout_width="@dimen/dp_12"
                                android:layout_height="@dimen/dp_12"
                                android:src="@drawable/land_icon_store"
                                android:importantForAccessibility="no" />

                            <LinearLayout
                                android:layout_width="@dimen/dp_0"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/dp_6">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/sp_9"
                                    android:textColor="#293A51"
                                    android:fontFamily="@font/retail_sans"
                                    android:includeFontPadding="false"
                                    android:text="@string/cloud_benefit_title_3" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/sp_7"
                                    android:textColor="#6E7C90"
                                    android:fontFamily="@font/retail_sans"
                                    android:includeFontPadding="false"
                                    android:text="@string/cloud_benefit_body_3"
                                    android:lineSpacingMultiplier="1.5"
                                    android:layout_marginTop="@dimen/dp_2" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="@dimen/dp_109"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:id="@+id/cloudQrCard"
                        android:layout_marginStart="@dimen/dp_16"
                        android:padding="@dimen/dp_8"
                        android:gravity="center_horizontal"
                        android:background="@drawable/land_field">

                        <LinearLayout
                            android:layout_width="@dimen/dp_68"
                            android:layout_height="@dimen/dp_68"
                            android:orientation="vertical"
                            android:background="#FFFFFF"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="@dimen/dp_38"
                                android:layout_height="@dimen/dp_38"
                                android:src="@drawable/land_icon_qr_code"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/sp_6_5"
                                android:textColor="#8795A8"
                                android:fontFamily="@font/retail_sans"
                                android:includeFontPadding="false"
                                android:text="@string/cloud_qr_placeholder"
                                android:layout_marginTop="@dimen/dp_4" />
                        </LinearLayout>

                        <Space
                            android:layout_width="@dimen/dp_0_5"
                            android:layout_height="@dimen/dp_0"
                            android:layout_weight="1"
                            android:minHeight="@dimen/dp_5" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/sp_7"
                            android:textColor="#293A51"
                            android:fontFamily="@font/retail_sans"
                            android:includeFontPadding="false"
                            android:text="@string/cloud_qr_caption"
                            android:gravity="center"
                            android:lineSpacingExtra="@dimen/dp_2" />

                        <Space
                            android:layout_width="@dimen/dp_0_5"
                            android:layout_height="@dimen/dp_0"
                            android:layout_weight="1"
                            android:minHeight="@dimen/dp_5" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_24"
                            android:textSize="@dimen/sp_9"
                            android:textColor="#FFFFFF"
                            android:fontFamily="@font/retail_sans"
                            android:includeFontPadding="false"
                            android:text="@string/settings_system_shop_login"
                            android:id="@+id/cloudLogin"
                            android:gravity="center"
                            android:background="@drawable/land_primary"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cloudAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/dp_4"
                android:visibility="gone"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_weight="300"
                    android:id="@+id/cloudShopCard"
                    android:padding="@dimen/dp_8"
                    android:background="@drawable/land_field">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#293A51"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:text="@string/land_title_shop"
                        android:id="@+id/cloudShopTitle" />

                    <Space
                        android:layout_width="@dimen/dp_0_5"
                        android:layout_height="@dimen/dp_5" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_8"
                        android:textColor="#293A51"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:text="@string/default_shop_name"
                        android:id="@+id/cloudShopInfo" />

                    <Space
                        android:layout_width="@dimen/dp_0_5"
                        android:layout_height="@dimen/dp_5" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_8"
                        android:textColor="#293A51"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:text="@string/default_shop_address_value"
                        android:id="@+id/cloudShopAddress" />

                    <Space
                        android:layout_width="@dimen/dp_0_5"
                        android:layout_height="@dimen/dp_5" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_8"
                        android:textColor="#293A51"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:text="@string/cloud_not_filled"
                        android:id="@+id/cloudShopPhone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_weight="300"
                    android:layout_marginStart="@dimen/dp_12"
                    android:id="@+id/cloudOperations">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_11"
                        android:textColor="#293A51"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:text="@string/cloud_loading"
                        android:id="@+id/cloudState" />

                    <Space
                        android:layout_width="@dimen/dp_0_5"
                        android:layout_height="@dimen/dp_4" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_8"
                        android:textColor="#6E7C90"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:text="@string/cloud_enable_hint"
                        android:id="@+id/cloudSyncHint" />

                    <Space
                        android:layout_width="@dimen/dp_0_5"
                        android:layout_height="@dimen/dp_0"
                        android:layout_weight="1"
                        android:minHeight="@dimen/dp_4" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_26"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:text="@string/cloud_enable"
                        android:id="@+id/cloudEnable"
                        android:gravity="center"
                        android:background="@drawable/land_primary"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_26"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:text="@string/cloud_retry"
                        android:id="@+id/cloudRefresh"
                        android:gravity="center"
                        android:background="@drawable/land_primary"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:id="@+id/cloudSyncActions"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_26"
                            android:textSize="@dimen/sp_9"
                            android:textColor="#FFFFFF"
                            android:fontFamily="@font/retail_sans"
                            android:includeFontPadding="false"
                            android:text="@string/cloud_sync_goods"
                            android:id="@+id/cloudSyncGoods"
                            android:gravity="center"
                            android:background="@drawable/land_primary"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginTop="@dimen/dp_0" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_26"
                            android:textSize="@dimen/sp_9"
                            android:textColor="#FFFFFF"
                            android:fontFamily="@font/retail_sans"
                            android:includeFontPadding="false"
                            android:text="@string/cloud_sync_images"
                            android:id="@+id/cloudSyncImages"
                            android:gravity="center"
                            android:background="@drawable/land_primary"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginTop="@dimen/dp_4" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</cc.huoyan.retail.common.ui.BoundedDialogLayout>
