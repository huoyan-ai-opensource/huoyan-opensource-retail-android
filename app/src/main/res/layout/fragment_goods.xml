<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="95"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/topRecord"
            android:layout_width="@dimen/dp_76"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/goods_tab_record"
            android:textColor="#2A3547"
            android:textSize="@dimen/sp_8"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/topLibrary"
            android:layout_width="@dimen/dp_76"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/goods_tab_library"
            android:textColor="#2A3547"
            android:textSize="@dimen/sp_8"
            android:textStyle="normal" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0_5"
        android:background="#EAEFF4" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="926"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/recordLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/dp_9"
                android:paddingVertical="@dimen/dp_8">

                <TextView
                    android:layout_width="@dimen/dp_40"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="end|center_vertical"
                    android:maxLines="2"
                    android:text="@string/goods_count_label"
                    android:textColor="#6B79A8"
                    android:textSize="@dimen/sp_7" />

                <TextView
                    android:id="@+id/goodsCount"
                    android:layout_width="@dimen/dp_80"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_9"
                    android:autofillHints="例：192.168.0.1"
                    android:background="@drawable/bg_grey_radius_3"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/dp_5"
                    android:paddingVertical="@dimen/dp_5"
                    android:textColor="#2A3547"
                    android:textSize="@dimen/sp_7" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_7"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/goods_count_hint"
                    android:textColor="#6B79A8"
                    android:textSize="@dimen/sp_7" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/libraryLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/dp_9"
                android:paddingVertical="@dimen/dp_8">

                <TextView
                    android:layout_width="@dimen/dp_40"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="end|center_vertical"
                    android:maxLines="2"
                    android:text="@string/goods_learned_label"
                    android:textColor="#6B79A8"
                    android:textSize="@dimen/sp_7" />

                <TextView
                    android:id="@+id/libraryLocalCount"
                    android:layout_width="@dimen/dp_80"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_9"
                    android:autofillHints="暂无"
                    android:background="@drawable/bg_grey_radius_3"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/dp_5"
                    android:paddingVertical="@dimen/dp_5"
                    android:textColor="#2A3547"
                    android:textSize="@dimen/sp_7" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_7"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/goods_learned_hint"
                    android:textColor="#6B79A8"
                    android:textSize="@dimen/sp_7" />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/dp_9"
                android:paddingBottom="@dimen/dp_8">

                <TextView
                    android:layout_width="@dimen/dp_40"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical"
                    android:text="@string/library_backup_time_label"
                    android:textColor="#6B79A8"
                    android:textSize="@dimen/sp_7" />

                <TextView
                    android:id="@+id/libraryBackupTime"
                    android:layout_width="@dimen/dp_80"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_9"
                    android:background="@drawable/bg_grey_radius_3"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/dp_5"
                    android:paddingVertical="@dimen/dp_5"
                    android:text="@string/text_unavailable"
                    android:textColor="#2A3547"
                    android:textSize="@dimen/sp_7" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_7"
                    android:text="@string/library_backup_time_hint"
                    android:textColor="#6B79A8"
                    android:textSize="@dimen/sp_7" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                android:layout_marginTop="@dimen/dp_9"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/backupRecognitionLibrary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_main_bg"
                    android:paddingHorizontal="@dimen/dp_15"
                    android:paddingVertical="@dimen/dp_6"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/library_backup"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_9" />

                <TextView
                    android:id="@+id/restoreRecognitionLibrary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_10"
                    android:background="@drawable/btn_main_bg"
                    android:paddingHorizontal="@dimen/dp_15"
                    android:paddingVertical="@dimen/dp_6"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/library_restore"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_9" />

                <TextView
                    android:id="@+id/learnImagePackage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_10"
                    android:background="@drawable/btn_main_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/dp_15"
                    android:paddingVertical="@dimen/dp_6"
                    android:text="@string/library_image_learning"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_9" />
            </LinearLayout>




        </LinearLayout>
    </LinearLayout>
</LinearLayout>
