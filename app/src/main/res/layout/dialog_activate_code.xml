<?xml version="1.0" encoding="utf-8"?>
<cc.huoyan.retail.common.ui.BoundedDialogLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/dp_6"
    android:background="@drawable/activation_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp_24"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="@dimen/dp_0"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/activation_input_title"
            android:textSize="@dimen/sp_12"
            android:textStyle="bold"
            android:textColor="#293A51"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/scan"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_24"
            android:paddingHorizontal="@dimen/dp_4"
            android:gravity="center"
            android:text="@string/activate_scan_code"
            android:textSize="@dimen/sp_8"
            android:textColor="#3F3EED"
            android:drawableStart="@drawable/land_icon_scan_line"
            android:drawablePadding="@dimen/dp_3"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/activationScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/dp_7"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/activation_input_description"
                android:textSize="@dimen/sp_8"
                android:textColor="#586982"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false" />

            <FrameLayout
                android:id="@+id/activationCodeField"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_32"
                android:layout_marginTop="@dimen/dp_7">

                <LinearLayout
                    android:id="@+id/activationSegments"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:importantForAccessibility="noHideDescendants">

                    <TextView
                        android:id="@+id/text1"
                        android:layout_width="@dimen/dp_0"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:fontFamily="monospace"
                        android:textSize="@dimen/sp_10"
                        android:textColor="#293A51"
                        android:background="@drawable/activation_segment"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="@dimen/dp_4"
                        android:gravity="center"
                        android:text="–"
                        android:textColor="#8994A5"
                        android:textSize="@dimen/sp_8" />

                    <TextView
                        android:id="@+id/text2"
                        android:layout_width="@dimen/dp_0"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:fontFamily="monospace"
                        android:textSize="@dimen/sp_10"
                        android:textColor="#293A51"
                        android:background="@drawable/activation_segment"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="@dimen/dp_4"
                        android:gravity="center"
                        android:text="–"
                        android:textColor="#8994A5"
                        android:textSize="@dimen/sp_8" />

                    <TextView
                        android:id="@+id/text3"
                        android:layout_width="@dimen/dp_0"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:fontFamily="monospace"
                        android:textSize="@dimen/sp_10"
                        android:textColor="#293A51"
                        android:background="@drawable/activation_segment"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="@dimen/dp_4"
                        android:gravity="center"
                        android:text="–"
                        android:textColor="#8994A5"
                        android:textSize="@dimen/sp_8" />

                    <TextView
                        android:id="@+id/text4"
                        android:layout_width="@dimen/dp_0"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:fontFamily="monospace"
                        android:textSize="@dimen/sp_10"
                        android:textColor="#293A51"
                        android:background="@drawable/activation_segment"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <cc.huoyan.retail.settings.ActivationCodeEditText
                    android:id="@+id/editText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:padding="@dimen/dp_0"
                    android:textColor="@android:color/transparent"
                    android:textColorHighlight="@android:color/transparent"
                    android:cursorVisible="false"
                    android:singleLine="true"
                    android:inputType="textVisiblePassword|textNoSuggestions"
                    android:imeOptions="flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:saveEnabled="false"
                    android:contentDescription="@string/activation_input_title" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/activationKeyboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/dp_7" />

            <LinearLayout
                android:id="@+id/activationKeyboardHintRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dp_24"
                android:layout_marginTop="@dimen/dp_7"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="@dimen/dp_0"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/activation_keyboard_hint"
                    android:textSize="@dimen/sp_7"
                    android:textColor="#586982"
                    android:fontFamily="@font/retail_sans"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/activationClear"
                    android:layout_width="@dimen/dp_32"
                    android:layout_height="@dimen/dp_24"
                    android:gravity="center"
                    android:text="@string/activation_clear"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_8"
                    android:background="@drawable/keypad_clear"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/activationActions"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_26"
        android:layout_marginTop="@dimen/dp_7">

        <TextView
            android:id="@+id/cancel"
            android:layout_width="@dimen/dp_0"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/button_cancel"
            android:textSize="@dimen/sp_9"
            android:textColor="#293A51"
            android:background="@drawable/activation_secondary"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/activate"
            android:layout_width="@dimen/dp_0"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dp_6"
            android:gravity="center"
            android:text="@string/panel_activation_button"
            android:textSize="@dimen/sp_9"
            android:textColor="@color/activation_primary_text"
            android:background="@drawable/activation_primary"
            android:enabled="false"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</cc.huoyan.retail.common.ui.BoundedDialogLayout>
