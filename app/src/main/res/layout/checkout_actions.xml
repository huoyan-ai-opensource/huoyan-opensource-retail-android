<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_28"
    android:id="@+id/checkoutActions"
    android:orientation="horizontal">

    <TextView
        android:layout_width="@dimen/dp_0"
        android:layout_height="match_parent"
        android:text="@string/button_retry_recognition"
        android:textSize="@dimen/sp_8"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/retail_sans"
        android:includeFontPadding="false"
        android:id="@+id/retryRecognize"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/dp_0"
        android:background="@drawable/btn_fa6400_radius_3"
        android:gravity="center"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="@dimen/sp_6"
        android:autoSizeMaxTextSize="@dimen/sp_8"
        android:autoSizeStepGranularity="@dimen/sp_0_5" />

    <TextView
        android:layout_width="@dimen/dp_0"
        android:layout_height="match_parent"
        android:text="@string/button_modify_goods_initial"
        android:textSize="@dimen/sp_8"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/retail_sans"
        android:includeFontPadding="false"
        android:id="@+id/modifyGoods"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/dp_6"
        android:background="@drawable/btn_fa6400_radius_3"
        android:gravity="center"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="@dimen/sp_6"
        android:autoSizeMaxTextSize="@dimen/sp_8"
        android:autoSizeStepGranularity="@dimen/sp_0_5" />

    <TextView
        android:layout_width="@dimen/dp_0"
        android:layout_height="match_parent"
        android:text="@string/button_confirm_results"
        android:textSize="@dimen/sp_8"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/retail_sans"
        android:includeFontPadding="false"
        android:id="@+id/confirm"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/dp_6"
        android:background="@drawable/btn_main_bg"
        android:gravity="center"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="@dimen/sp_6"
        android:autoSizeMaxTextSize="@dimen/sp_8"
        android:autoSizeStepGranularity="@dimen/sp_0_5" />
</LinearLayout>