<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#70142033"
    android:padding="@dimen/dp_8">

    <cc.huoyan.retail.common.ui.BoundedDialogLayout
        android:id="@+id/boundedCheckoutDialog"
        android:layout_width="@dimen/dp_210"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/dp_10"
        android:background="@drawable/land_card">

        <TextView
            android:id="@+id/keyboardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="@dimen/sp_11"
            android:textStyle="bold"
            android:textColor="#293A51"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_26"
            android:layout_marginTop="@dimen/dp_6"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/goodsNumberValue"
                android:layout_width="@dimen/dp_0"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:gravity="center"
                android:background="@drawable/land_field"
                android:textSize="@dimen/sp_14"
                android:textColor="#3F3EED"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/clear"
                android:layout_width="@dimen/dp_36"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/dp_4"
                android:gravity="center"
                android:text="@string/button_clear"
                android:textSize="@dimen/sp_9"
                android:textColor="@color/white"
                android:background="@drawable/keypad_clear"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <include
            layout="@layout/checkout_numeric_keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_6">

            <TextView
                android:id="@+id/cancel"
                android:layout_width="@dimen/dp_0"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/button_cancel"
                android:textSize="@dimen/sp_9"
                android:textColor="#293A51"
                android:background="@drawable/land_secondary"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/confirm"
                android:layout_width="@dimen/dp_0"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/dp_6"
                android:gravity="center"
                android:text="@string/button_ok"
                android:textSize="@dimen/sp_9"
                android:textColor="@color/white"
                android:background="@drawable/land_primary"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </cc.huoyan.retail.common.ui.BoundedDialogLayout>
</FrameLayout>
