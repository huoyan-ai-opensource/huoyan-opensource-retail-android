<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66203351"
    android:padding="@dimen/dp_10">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="@dimen/dp_400"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/land_card"
                android:id="@+id/checkoutDialogCard"
                android:paddingHorizontal="@dimen/dp_8"
                android:paddingBottom="@dimen/dp_8"
                android:paddingTop="@dimen/dp_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_24"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/dp_2">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:text="@string/checkout_scale_title"
                        android:textSize="@dimen/sp_12"
                        android:textColor="#293A51"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:textStyle="bold"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="@dimen/dp_24"
                        android:layout_height="@dimen/dp_24"
                        android:text="×"
                        android:textSize="@dimen/sp_16"
                        android:textColor="#6E7C90"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:id="@+id/closeDialog"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/button_cancel" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:layout_weight="45"
                        android:layout_marginEnd="@dimen/dp_12">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_58"
                            android:background="@drawable/land_field"
                            android:orientation="vertical"
                            android:padding="@dimen/dp_8">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/checkout_net"
                                android:textSize="@dimen/sp_6_5"
                                android:textColor="#637187"
                                android:fontFamily="@font/retail_sans"
                                android:includeFontPadding="false" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dp_0"
                                android:layout_weight="1"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="@dimen/dp_0"
                                    android:layout_height="wrap_content"
                                    android:text="—"
                                    android:textSize="@dimen/sp_17"
                                    android:textColor="#293A51"
                                    android:fontFamily="@font/retail_sans"
                                    android:includeFontPadding="false"
                                    android:id="@+id/dialogNetWeight"
                                    android:textStyle="bold"
                                    android:layout_weight="1" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="kg"
                                    android:textSize="@dimen/sp_7"
                                    android:textColor="#637187"
                                    android:fontFamily="@font/retail_sans"
                                    android:includeFontPadding="false" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="@dimen/dp_0"
                                    android:layout_height="wrap_content"
                                    android:text="—"
                                    android:textSize="@dimen/sp_6_5"
                                    android:textColor="#637187"
                                    android:fontFamily="@font/retail_sans"
                                    android:includeFontPadding="false"
                                    android:id="@+id/dialogTareWeight"
                                    android:layout_weight="1" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="—"
                                    android:textSize="@dimen/sp_6_5"
                                    android:textColor="#637187"
                                    android:fontFamily="@font/retail_sans"
                                    android:includeFontPadding="false"
                                    android:id="@+id/dialogGrossWeight" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginTop="@dimen/dp_4"
                            android:layout_marginBottom="@dimen/dp_4">

                            <LinearLayout
                                android:layout_width="@dimen/dp_0"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="@dimen/dp_4">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/checkout_tare_grams"
                                    android:textSize="@dimen/sp_8"
                                    android:textColor="#293A51"
                                    android:fontFamily="@font/retail_sans"
                                    android:includeFontPadding="false"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/checkout_tare_hint"
                                    android:textSize="@dimen/sp_6_5"
                                    android:textColor="#637187"
                                    android:fontFamily="@font/retail_sans"
                                    android:includeFontPadding="false"
                                    android:layout_marginTop="@dimen/dp_2" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="@dimen/dp_32"
                                android:layout_height="@dimen/dp_20"
                                android:text="@string/checkout_clear"
                                android:textSize="@dimen/sp_9"
                                android:textColor="@color/white"
                                android:fontFamily="@font/retail_sans"
                                android:includeFontPadding="false"
                                android:id="@+id/clearInput"
                                android:gravity="center"
                                android:background="@drawable/keypad_clear"
                                android:clickable="true"
                                android:focusable="true"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <Space
                            android:layout_width="@dimen/dp_0_5"
                            android:layout_height="@dimen/dp_0"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_30"
                            android:gravity="center_vertical"
                            android:background="@drawable/land_field"
                            android:paddingHorizontal="@dimen/dp_8">

                            <TextView
                                android:layout_width="@dimen/dp_0"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="@dimen/sp_14"
                                android:textColor="#293A51"
                                android:fontFamily="@font/retail_sans"
                                android:includeFontPadding="false"
                                android:id="@+id/tareInput"
                                android:layout_weight="1"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/unit_g"
                                android:textSize="@dimen/sp_7"
                                android:textColor="#637187"
                                android:fontFamily="@font/retail_sans"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                    </LinearLayout>

                    <include
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="55"
                        layout="@layout/checkout_numeric_keyboard" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/checkout_zero_hint"
                    android:textSize="@dimen/sp_6_5"
                    android:textColor="#637187"
                    android:fontFamily="@font/retail_sans"
                    android:includeFontPadding="false"
                    android:layout_marginTop="@dimen/dp_4" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/dp_4">

                    <TextView
                        android:layout_width="@dimen/dp_80"
                        android:layout_height="@dimen/dp_28"
                        android:text="@string/checkout_zero"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#3F3EED"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:id="@+id/zeroScale"
                        android:gravity="center"
                        android:background="@drawable/land_soft"
                        android:clickable="true"
                        android:focusable="true"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="@dimen/dp_0_5"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="@dimen/dp_112"
                        android:layout_height="@dimen/dp_28"
                        android:text="@string/checkout_confirm_tare"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:id="@+id/confirmTare"
                        android:gravity="center"
                        android:background="@drawable/land_primary"
                        android:clickable="true"
                        android:focusable="true"
                        android:textStyle="bold"
                        android:layout_marginStart="@dimen/dp_8" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
