<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F4F8"
    android:padding="@dimen/dp_0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/dp_12">

        <ImageView
            android:layout_width="@dimen/dp_18"
            android:layout_height="@dimen/dp_18"
            android:src="@mipmap/ic_launcher"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:text="@string/home_title"
            android:textColor="#293A51"
            android:textSize="@dimen/sp_12"
            android:textStyle="bold"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false" />

        <View
            android:layout_width="@dimen/dp_0_5"
            android:layout_height="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_12"
            android:background="#E7EBF1" />

        <LinearLayout
            android:layout_width="@dimen/dp_0"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp_9"
                android:textColor="#293A51"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:id="@+id/homeStoreSubtitle"
                android:maxLines="1"
                android:ellipsize="end"
                android:textStyle="bold" />

            <TextClock
                android:includeFontPadding="false"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_12"
                android:format12Hour="yyyy-MM-dd E  HH:mm:ss"
                android:format24Hour="yyyy-MM-dd E  HH:mm:ss"
                android:textSize="@dimen/sp_6_5"
                android:textColor="#6E7C90"
                android:fontFamily="@font/retail_sans" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_24"
            android:gravity="center"
            android:paddingHorizontal="@dimen/dp_6"
            android:background="@drawable/land_soft"
            android:id="@+id/homeCloudStatus"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="@dimen/dp_8">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp_8"
                android:textColor="#8795A8"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:text="●"
                android:id="@+id/homeCloudDot"
                android:layout_marginEnd="@dimen/dp_4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp_7"
                android:textColor="#293A51"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:text="@string/cloud_title"
                android:id="@+id/homeCloudLabel" />
        </LinearLayout>

        <TextView
            android:id="@+id/aboutDevice"
            android:layout_width="@dimen/dp_64"
            android:layout_height="@dimen/dp_24"
            android:gravity="center"
            android:text="@string/home_about_device"
            android:textColor="#3F3EED"
            android:textSize="@dimen/sp_8"
            android:textStyle="bold"
            android:background="@drawable/land_soft"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_12"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/dp_12">

        <LinearLayout
            style="@style/HomeCheckoutCard"
            android:id="@+id/enterCheckout"
            android:layout_width="@dimen/dp_0"
            android:layout_weight="28"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="@dimen/dp_26"
                android:layout_height="@dimen/dp_26"
                android:src="@drawable/home_icon_product_scan"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dp_23"
                android:layout_marginTop="@dimen/dp_12"
                android:text="@string/home_checkout"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:text="@string/home_checkout_subtitle"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/sp_9"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:id="@+id/homeActivationHint" />

            <Space
                android:layout_width="@dimen/dp_0_5"
                android:layout_height="@dimen/dp_0"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/homeCheckoutButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_26"
                android:gravity="center"
                android:background="@drawable/land_soft">

                <ImageView
                    android:id="@+id/homeCheckoutArrow"
                    android:layout_width="@dimen/dp_11"
                    android:layout_height="@dimen/dp_11"
                    android:src="@drawable/land_icon_arrow_right"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_26"
                    android:gravity="center"
                    android:text="@string/home_enter_checkout"
                    android:textColor="#3F3EED"
                    android:textSize="@dimen/sp_9"
                    android:textStyle="bold"
                    android:fontFamily="@font/retail_sans"
                    android:includeFontPadding="false"
                    android:layout_marginStart="@dimen/dp_5"
                    android:id="@+id/homeCheckoutAction" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:layout_weight="72"
            android:layout_marginStart="@dimen/dp_12"
            android:orientation="vertical"
            android:background="#F2F4F8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0"
                android:layout_weight="1"
                android:orientation="horizontal">

                <include
                    layout="@layout/home_feature_sdk"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_0" />

                <include
                    layout="@layout/home_feature_recognition"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_8" />

                <include
                    layout="@layout/home_feature_learning"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_8" />
            </LinearLayout>

            <Space
                android:layout_width="@dimen/dp_0_5"
                android:layout_height="@dimen/dp_8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0"
                android:layout_weight="1"
                android:orientation="horizontal">

                <include
                    layout="@layout/home_feature_camera"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_0" />

                <include
                    layout="@layout/home_feature_scale"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_8" />

                <include
                    layout="@layout/home_feature_print"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_8" />
            </LinearLayout>

            <Space
                android:layout_width="@dimen/dp_0_5"
                android:layout_height="@dimen/dp_8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0"
                android:layout_weight="1"
                android:orientation="horizontal">

                <include
                    layout="@layout/home_feature_goods"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_0" />

                <include
                    layout="@layout/home_feature_shop"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_8" />

                <include
                    layout="@layout/home_feature_maintenance"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_8" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_32">

        <cc.huoyan.retail.common.ui.BrandWatermarkView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:layout_marginBottom="@dimen/dp_8"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="@dimen/dp_0"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_6"
                        android:textColor="#66758B"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:id="@+id/homeClientVersion" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_2_5"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ProgressBar
                            android:id="@+id/homeSdkStartupProgress"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="@dimen/dp_6"
                            android:layout_height="@dimen/dp_6"
                            android:layout_marginEnd="@dimen/dp_3"
                            android:indeterminate="true"
                            android:indeterminateTint="#3F3EED"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/homeSdkVersion"
                            android:layout_width="@dimen/dp_0"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/home_sdk_starting"
                            android:textSize="@dimen/sp_6"
                            android:textColor="#66758B"
                            android:fontFamily="@font/retail_sans"
                            android:includeFontPadding="false"
                            android:accessibilityLiveRegion="polite" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_6"
                    android:textColor="#66758B"
                    android:fontFamily="@font/retail_sans"
                    android:includeFontPadding="false"
                    android:text="@string/home_copyright" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_6"
                    android:textColor="#66758B"
                    android:fontFamily="@font/retail_sans"
                    android:includeFontPadding="false"
                    android:id="@+id/homeSerial" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_6"
                    android:textColor="#66758B"
                    android:fontFamily="@font/retail_sans"
                    android:includeFontPadding="false"
                    android:id="@+id/homeConnection"
                    android:layout_marginTop="@dimen/dp_2_5" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>