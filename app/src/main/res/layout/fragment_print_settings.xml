<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="95"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/dp_10"
        android:text="@string/settings_tab_print"
        android:textColor="#2A3547"
        android:textSize="@dimen/sp_8"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0_5"
        android:background="#EAEFF4" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="926"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_9"
            android:paddingVertical="@dimen/dp_7">

            <TextView
                android:layout_width="@dimen/dp_40"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:maxLines="2"
                android:text="@string/settings_system_print_module"
                android:textColor="#6B79A8"
                android:textSize="@dimen/sp_7" />

            <Switch
                android:id="@+id/printModule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_9"
                android:layout_marginEnd="@dimen/dp_68"
                android:background="@android:color/transparent"
                android:checked="false"
                android:thumb="@drawable/thumb_selector"
                android:track="@drawable/track_selector" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0_5"
            android:background="#EAEFF4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_9"
            android:paddingVertical="@dimen/dp_7">

            <TextView
                android:layout_width="@dimen/dp_40"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:maxLines="2"
                android:text="@string/settings_system_printer_type"
                android:textColor="#6B79A8"
                android:textSize="@dimen/sp_7" />

            <LinearLayout
                android:id="@+id/printInitNameLayout"
                android:layout_width="@dimen/dp_80"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_9"
                android:background="@drawable/bg_white_radius_dddddd_3"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/printerInitName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingHorizontal="@dimen/dp_5"
                    android:paddingVertical="@dimen/dp_6"
                    android:text="@string/settings_system_printer_type_pick"
                    android:textColor="#2A3547"
                    android:textSize="@dimen/sp_7"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="@dimen/dp_10"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/dp_5"
                    android:background="@drawable/land_icon_chevron_right" />
            </LinearLayout>

            <TextView
                android:id="@+id/printerTypeName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_7"
                android:text="@string/printer_type_default"
                android:textColor="#6B79A8"
                android:textSize="@dimen/sp_7" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0_5"
            android:background="#EAEFF4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_9"
            android:paddingVertical="@dimen/dp_7">

            <TextView
                android:layout_width="@dimen/dp_40"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:maxLines="2"
                android:text="@string/settings_system_printer_model"
                android:textColor="#6B79A8"
                android:textSize="@dimen/sp_7" />

            <LinearLayout
                android:id="@+id/printerModelLayout"
                android:layout_width="@dimen/dp_80"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_9"
                android:background="@drawable/bg_white_radius_dddddd_3"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/printerModel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingHorizontal="@dimen/dp_5"
                    android:paddingVertical="@dimen/dp_6"
                    android:text="@string/settings_system_printer_model_pick"
                    android:textColor="#2A3547"
                    android:textSize="@dimen/sp_7"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="@dimen/dp_10"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/dp_5"
                    android:background="@drawable/land_icon_chevron_right" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0_5"
            android:background="#EAEFF4" />

        <include layout="@layout/printer_paper_setting"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="@dimen/dp_10" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_10"
            android:layout_marginTop="@dimen/dp_9"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/communicationTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_main_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="@dimen/dp_15"
                android:paddingVertical="@dimen/dp_6"
                android:text="@string/settings_system_printer_test_connection"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_9" />

            <TextView
                android:id="@+id/printTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                android:background="@drawable/btn_main_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="@dimen/dp_15"
                android:paddingVertical="@dimen/dp_6"
                android:text="@string/settings_system_printer_test_print"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_9" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
