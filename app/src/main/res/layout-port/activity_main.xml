<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="#F2F4F8"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60"
        android:id="@+id/checkoutNavigation"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dp_8"
        android:paddingVertical="@dimen/dp_4"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_16"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:text="@string/default_shop_name"
                android:textSize="@dimen/sp_9"
                android:textColor="#293A51"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:id="@+id/shopName"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_weight="1" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/checkoutClock"
                android:format12Hour="yyyy/MM/dd HH:mm:ss"
                android:format24Hour="yyyy/MM/dd HH:mm:ss"
                android:textSize="@dimen/sp_5_5"
                android:textColor="#637187"
                android:fontFamily="@font/retail_sans" />
        </LinearLayout>

        <include
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_32"
            android:layout_marginTop="@dimen/dp_4"
            layout="@layout/checkout_weights" />
    </LinearLayout>

    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="40"
        layout="@layout/checkout_camera" />

    <include
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="60"
        android:layout_marginTop="@dimen/dp_4"
        layout="@layout/checkout_results" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_70"
        android:id="@+id/checkoutFooter"
        android:orientation="vertical"
        android:background="@drawable/land_card"
        android:paddingHorizontal="@dimen/dp_6"
        android:paddingTop="@dimen/dp_4"
        android:paddingBottom="@dimen/dp_6"
        android:layout_marginHorizontal="@dimen/dp_8"
        android:layout_marginTop="@dimen/dp_2"
        android:layout_marginBottom="@dimen/dp_4">

        <include
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_28"
            layout="@layout/checkout_summary" />

        <include
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_28"
            android:layout_marginTop="@dimen/dp_4"
            layout="@layout/checkout_actions" />
    </LinearLayout>
</LinearLayout>