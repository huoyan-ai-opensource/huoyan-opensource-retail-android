<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/main" android:background="#F2F4F8" android:orientation="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="120dp" android:id="@+id/checkoutNavigation" android:background="#FFFFFF" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingVertical="8dp" android:gravity="center_vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical">
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/default_shop_name" android:textSize="18sp" android:textColor="#293A51" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/shopName" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" />
      <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/checkoutClock" android:format12Hour="yyyy/MM/dd HH:mm:ss" android:format24Hour="yyyy/MM/dd HH:mm:ss" android:textSize="11sp" android:textColor="#637187" android:fontFamily="@font/retail_sans" />
    </LinearLayout>
    <include android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="8dp" layout="@layout/checkout_weights" />
  </LinearLayout>
  <include android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="40" layout="@layout/checkout_camera" />
  <include android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="60" android:layout_marginTop="8dp" layout="@layout/checkout_results" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="140dp" android:id="@+id/checkoutFooter" android:orientation="vertical" android:background="@drawable/land_card" android:paddingHorizontal="12dp" android:paddingTop="8dp" android:paddingBottom="12dp" android:layout_marginHorizontal="16dp" android:layout_marginTop="4dp" android:layout_marginBottom="8dp">
    <include android:layout_width="match_parent" android:layout_height="56dp" layout="@layout/checkout_summary" />
    <include android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" layout="@layout/checkout_actions" />
  </LinearLayout>
</LinearLayout>