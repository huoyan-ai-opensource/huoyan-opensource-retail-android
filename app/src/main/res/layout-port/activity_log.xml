<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F4F8">

    <include layout="@layout/land_page_navigation" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:orientation="vertical"
        android:background="#F2F4F8"
        android:layout_weight="1"
        android:paddingLeft="@dimen/dp_10"
        android:paddingRight="@dimen/dp_10"
        android:paddingBottom="@dimen/dp_10">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="@dimen/dp_0"
            android:paddingRight="@dimen/dp_0"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="@dimen/dp_8"
                android:background="@drawable/land_card"
                android:layout_marginStart="@dimen/dp_0"
                android:layout_marginTop="@dimen/dp_0">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_17_5"
                    android:textSize="@dimen/sp_12"
                    android:textColor="#293A51"
                    android:includeFontPadding="false"
                    android:gravity="center_vertical"
                    android:text="@string/land_log_files"
                    android:textStyle="bold"
                    android:fontFamily="@font/retail_sans" />

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_8" />

                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:id="@+id/pathRecycler" />

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_8" />

                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_0"
                    android:id="@+id/recyclerView"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="@dimen/dp_8"
                android:background="@drawable/land_card"
                android:layout_marginStart="@dimen/dp_0"
                android:layout_marginTop="@dimen/dp_8">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_17_5"
                    android:textSize="@dimen/sp_12"
                    android:textColor="#293A51"
                    android:includeFontPadding="false"
                    android:gravity="center_vertical"
                    android:text="@string/land_log_content"
                    android:textStyle="bold"
                    android:id="@+id/logFileTitle"
                    android:fontFamily="@font/retail_sans" />

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_12" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_8"
                    android:textColor="#6E7C90"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="@dimen/dp_1_5"
                    android:text="@string/land_file_content"
                    android:fontFamily="@font/retail_sans" />

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_12" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_0"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/logFileContent"
                        android:textSize="@dimen/sp_8"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:textIsSelectable="true"
                        android:lineSpacingExtra="@dimen/dp_4"
                        android:text="@string/land_log_select_hint"
                        android:fontFamily="@font/retail_sans" />
                </ScrollView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>