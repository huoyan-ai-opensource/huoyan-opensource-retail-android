<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F4F8">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/dp_10"
            android:paddingRight="@dimen/dp_10"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/dp_0"
                android:layout_marginTop="@dimen/dp_0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/dp_6">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:text="@string/recognition_model_title"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/retail_sans"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/dp_6"
                    android:paddingBottom="@dimen/dp_6"
                    android:paddingLeft="@dimen/dp_10"
                    android:paddingRight="@dimen/dp_10"
                    android:gravity="center_vertical"
                    android:background="@drawable/land_card">

                    <LinearLayout
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/dp_8">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/current_model_label"
                            android:textSize="@dimen/sp_8"
                            android:textColor="#6E7C90"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/retail_sans" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="@dimen/sp_12"
                            android:textColor="#293A51"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/retail_sans"
                            android:layout_marginTop="@dimen/dp_2"
                            android:id="@+id/currentModel"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/model_version_unknown"
                            android:textSize="@dimen/sp_8"
                            android:textColor="#6E7C90"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/retail_sans"
                            android:layout_marginTop="@dimen/dp_2"
                            android:id="@+id/modelVersion" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_24"
                        android:text="@string/switch_model"
                        android:textSize="@dimen/sp_8"
                        android:textColor="#3F3EED"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/retail_sans"
                        android:minWidth="@dimen/dp_56"
                        android:paddingHorizontal="@dimen/dp_8"
                        android:gravity="center"
                        android:background="@drawable/land_soft"
                        android:clickable="true"
                        android:focusable="true"
                        android:id="@+id/switchModel"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/dp_42"
                    android:layout_marginTop="@dimen/dp_4"
                    android:paddingHorizontal="@dimen/dp_10"
                    android:background="@drawable/land_card">

                    <LinearLayout
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/sp_10"
                            android:textColor="#293A51"
                            android:includeFontPadding="false"
                            android:text="@string/settings_system_stable_recognition"
                            android:textStyle="bold"
                            android:fontFamily="@font/retail_sans" />

                        <Space
                            android:layout_width="@dimen/dp_0_5"
                            android:layout_height="@dimen/dp_3" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/sp_7_5"
                            android:textColor="#6E7C90"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="@dimen/dp_1_5"
                            android:text="@string/land_stable_recognition_hint"
                            android:fontFamily="@font/retail_sans" />
                    </LinearLayout>

                    <cc.huoyan.retail.common.ui.LandscapeSwitch
                        android:layout_width="@dimen/dp_26"
                        android:layout_height="@dimen/dp_24"
                        android:id="@+id/stableRecognition"
                        android:showText="false"
                        android:thumb="@drawable/land_switch_thumb"
                        android:track="@drawable/land_switch_track"
                        android:splitTrack="false"
                        android:switchMinWidth="@dimen/dp_26"
                        android:thumbTint="@null"
                        android:trackTint="@null"
                        android:padding="@dimen/dp_0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp_42"
                    android:layout_marginTop="@dimen/dp_4"
                    android:paddingHorizontal="@dimen/dp_10"
                    android:background="@drawable/land_card">

                    <include layout="@layout/recognition_delete_setting" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dp_10"
                android:background="@drawable/land_card"
                android:layout_marginStart="@dimen/dp_0"
                android:layout_marginTop="@dimen/dp_10">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_17_5"
                    android:textSize="@dimen/sp_12"
                    android:textColor="#293A51"
                    android:includeFontPadding="false"
                    android:gravity="center_vertical"
                    android:text="@string/land_recognition_parameters"
                    android:textStyle="bold"
                    android:fontFamily="@font/retail_sans" />

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_10" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_48"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_16"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="@dimen/dp_0"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/sp_10"
                            android:textColor="#293A51"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:text="@string/settings_system_confidence"
                            android:textStyle="bold"
                            android:fontFamily="@font/retail_sans" />

                        <TextView
                            android:layout_width="@dimen/dp_40"
                            android:layout_height="wrap_content"
                            android:id="@+id/confText"
                            android:textSize="@dimen/sp_11"
                            android:textColor="#3F3EED"
                            android:includeFontPadding="false"
                            android:gravity="end"
                            android:textStyle="bold"
                            android:fontFamily="@font/retail_sans" />
                    </LinearLayout>

                    <cc.huoyan.retail.common.ui.FloatSeekBar
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_12"
                        android:id="@+id/confSeekBar"
                        android:max="100"
                        android:paddingStart="@dimen/dp_0"
                        android:paddingEnd="@dimen/dp_0"
                        android:progressDrawable="@drawable/land_seekbar"
                        android:thumb="@drawable/transparent_thumb"
                        android:background="@null"
                        android:minHeight="@dimen/dp_4"
                        android:maxHeight="@dimen/dp_4"
                        android:splitTrack="false" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_7_5"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="@dimen/dp_1_5"
                        android:text="@string/land_confidence_hint"
                        android:fontFamily="@font/retail_sans" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_10" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_48"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_16"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="@dimen/dp_0"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/sp_10"
                            android:textColor="#293A51"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:text="@string/settings_system_iou"
                            android:textStyle="bold"
                            android:fontFamily="@font/retail_sans" />

                        <TextView
                            android:layout_width="@dimen/dp_40"
                            android:layout_height="wrap_content"
                            android:id="@+id/iouText"
                            android:textSize="@dimen/sp_11"
                            android:textColor="#3F3EED"
                            android:includeFontPadding="false"
                            android:gravity="end"
                            android:textStyle="bold"
                            android:fontFamily="@font/retail_sans" />
                    </LinearLayout>

                    <cc.huoyan.retail.common.ui.FloatSeekBar
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_12"
                        android:id="@+id/iouSeekBar"
                        android:max="100"
                        android:paddingStart="@dimen/dp_0"
                        android:paddingEnd="@dimen/dp_0"
                        android:progressDrawable="@drawable/land_seekbar"
                        android:thumb="@drawable/transparent_thumb"
                        android:background="@null"
                        android:minHeight="@dimen/dp_4"
                        android:maxHeight="@dimen/dp_4"
                        android:splitTrack="false" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_7_5"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="@dimen/dp_1_5"
                        android:text="@string/land_iou_hint"
                        android:fontFamily="@font/retail_sans" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_10" />

                <include layout="@layout/recognition_sensitivity_setting" />

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_10" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingHorizontal="@dimen/dp_10">

        <Space
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_0_5"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/restoreRecognitionDefaults"
            android:layout_width="wrap_content"
            android:minWidth="@dimen/dp_56"
            android:paddingHorizontal="@dimen/dp_8"
            android:layout_height="@dimen/dp_28"
            android:layout_marginEnd="@dimen/dp_6"
            android:text="@string/recognition_restore_defaults"
            android:textSize="@dimen/sp_9"
            android:textColor="#3F3EED"
            android:gravity="center"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:background="@drawable/land_soft"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/retail_sans" />

        <TextView
            android:layout_width="wrap_content"
            android:minWidth="@dimen/dp_56"
            android:paddingHorizontal="@dimen/dp_8"
            android:layout_height="@dimen/dp_28"
            android:id="@+id/saveSettings"
            android:textSize="@dimen/sp_9"
            android:textColor="#FFFFFF"
            android:includeFontPadding="false"
            android:gravity="center"
            android:background="@drawable/land_primary"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="@dimen/dp_0"
            android:text="@string/button_save_config"
            android:textStyle="bold"
            android:fontFamily="@font/retail_sans" />
    </LinearLayout>
</LinearLayout>
