<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F2F4F8">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="@dimen/ui_page_horizontal" android:paddingRight="@dimen/ui_page_horizontal" android:paddingTop="@dimen/ui_page_vertical" android:paddingBottom="@dimen/ui_page_vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="0dp" android:layout_marginTop="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/recognition_model_title" android:textSize="18sp" android:textColor="#6E7C90" android:includeFontPadding="false" android:fontFamily="@font/retail_sans" android:layout_weight="1" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:paddingBottom="12dp" android:paddingLeft="20dp" android:paddingRight="20dp" android:gravity="center_vertical" android:background="@drawable/land_card">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginEnd="16dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/current_model_label" android:textSize="16sp" android:textColor="#6E7C90" android:includeFontPadding="false" android:fontFamily="@font/retail_sans" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textSize="24sp" android:textColor="#293A51" android:includeFontPadding="false" android:fontFamily="@font/retail_sans" android:layout_marginTop="4dp" android:id="@+id/currentModel" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/model_version_unknown" android:textSize="16sp" android:textColor="#6E7C90" android:includeFontPadding="false" android:fontFamily="@font/retail_sans" android:layout_marginTop="4dp" android:id="@+id/modelVersion" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/switch_model" android:textSize="16sp" android:textColor="#3F3EED" android:includeFontPadding="false" android:fontFamily="@font/retail_sans" android:minWidth="112dp" android:paddingHorizontal="16dp" android:gravity="center" android:background="@drawable/land_soft" android:clickable="true" android:focusable="true" android:id="@+id/switchModel" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="84dp" android:layout_marginTop="8dp" android:paddingHorizontal="20dp" android:background="@drawable/land_card">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="20sp" android:textColor="#293A51" android:includeFontPadding="false" android:text="@string/settings_system_stable_recognition" android:textStyle="bold" android:fontFamily="@font/retail_sans" />
                        <Space android:layout_width="1dp" android:layout_height="6dp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#6E7C90" android:includeFontPadding="false" android:lineSpacingExtra="3dp" android:text="@string/land_stable_recognition_hint" android:fontFamily="@font/retail_sans" />
                    </LinearLayout>
                    <cc.huoyan.retail.common.ui.LandscapeSwitch android:layout_width="52dp" android:layout_height="48dp" android:id="@+id/stableRecognition" android:showText="false" android:thumb="@drawable/land_switch_thumb" android:track="@drawable/land_switch_track" android:splitTrack="false" android:switchMinWidth="52dp" android:thumbTint="@null" android:trackTint="@null" android:padding="0dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="84dp" android:layout_marginTop="8dp" android:paddingHorizontal="20dp" android:background="@drawable/land_card">
                    <include layout="@layout/recognition_delete_setting" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/ui_card_padding" android:background="@drawable/land_card" android:layout_marginStart="0dp" android:layout_marginTop="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="35dp" android:textSize="24sp" android:textColor="#293A51" android:includeFontPadding="false" android:gravity="center_vertical" android:text="@string/land_recognition_parameters" android:textStyle="bold" android:fontFamily="@font/retail_sans" />
                <Space android:layout_width="1dp" android:layout_height="20dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="96dp" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="20sp" android:textColor="#293A51" android:includeFontPadding="false" android:layout_weight="1" android:text="@string/settings_system_confidence" android:textStyle="bold" android:fontFamily="@font/retail_sans" />
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:id="@+id/confText" android:textSize="22sp" android:textColor="#3F3EED" android:includeFontPadding="false" android:gravity="end" android:textStyle="bold" android:fontFamily="@font/retail_sans" />
                    </LinearLayout>
                    <cc.huoyan.retail.common.ui.FloatSeekBar android:layout_width="match_parent" android:layout_height="24dp" android:id="@+id/confSeekBar" android:max="100" android:paddingStart="0dp" android:paddingEnd="0dp" android:progressDrawable="@drawable/land_seekbar" android:thumb="@drawable/transparent_thumb" android:background="@null" android:minHeight="8dp" android:maxHeight="8dp" android:splitTrack="false" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#6E7C90" android:includeFontPadding="false" android:lineSpacingExtra="3dp" android:text="@string/land_confidence_hint" android:fontFamily="@font/retail_sans" />
                </LinearLayout>
                <Space android:layout_width="1dp" android:layout_height="20dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="96dp" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="20sp" android:textColor="#293A51" android:includeFontPadding="false" android:layout_weight="1" android:text="@string/settings_system_iou" android:textStyle="bold" android:fontFamily="@font/retail_sans" />
                        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:id="@+id/iouText" android:textSize="22sp" android:textColor="#3F3EED" android:includeFontPadding="false" android:gravity="end" android:textStyle="bold" android:fontFamily="@font/retail_sans" />
                    </LinearLayout>
                    <cc.huoyan.retail.common.ui.FloatSeekBar android:layout_width="match_parent" android:layout_height="24dp" android:id="@+id/iouSeekBar" android:max="100" android:paddingStart="0dp" android:paddingEnd="0dp" android:progressDrawable="@drawable/land_seekbar" android:thumb="@drawable/transparent_thumb" android:background="@null" android:minHeight="8dp" android:maxHeight="8dp" android:splitTrack="false" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#6E7C90" android:includeFontPadding="false" android:lineSpacingExtra="3dp" android:text="@string/land_iou_hint" android:fontFamily="@font/retail_sans" />
                </LinearLayout>
                <Space android:layout_width="1dp" android:layout_height="20dp" />
                <include layout="@layout/recognition_sensitivity_setting" />
                <Space android:layout_width="1dp" android:layout_height="20dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="88dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="#FFFFFF" android:paddingHorizontal="@dimen/ui_page_horizontal">
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/restoreRecognitionDefaults" android:layout_width="wrap_content" android:minWidth="112dp" android:paddingHorizontal="16dp" android:layout_height="56dp" android:layout_marginEnd="12dp" android:text="@string/recognition_restore_defaults" android:textSize="18sp" android:textColor="#3F3EED" android:gravity="center" android:textStyle="bold" android:includeFontPadding="false" android:background="@drawable/land_soft" android:clickable="true" android:focusable="true" android:fontFamily="@font/retail_sans" />
        <TextView android:layout_width="wrap_content" android:minWidth="112dp" android:paddingHorizontal="16dp" android:layout_height="56dp" android:id="@+id/saveSettings" android:textSize="18sp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:gravity="center" android:background="@drawable/land_primary" android:clickable="true" android:focusable="true" android:layout_marginStart="0dp" android:text="@string/button_save_config" android:textStyle="bold" android:fontFamily="@font/retail_sans" />
    </LinearLayout>
</LinearLayout>
