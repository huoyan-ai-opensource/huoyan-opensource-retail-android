<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeGoods"
    android:layout_width="@dimen/dp_0"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="@dimen/dp_7"
    android:background="@drawable/home_feature_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <ImageView
        android:layout_width="@dimen/dp_14"
        android:layout_height="@dimen/dp_14"
        android:src="@drawable/land_icon_database"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_6"
        android:orientation="vertical"
        android:layout_weight="1">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dp_0"
            android:gravity="center_vertical"
            android:text="@string/home_goods_title"
            android:textColor="#293A51"
            android:textSize="@dimen/sp_9"
            android:textStyle="bold"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dp_0"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/dp_2"
            android:text="@string/home_goods_subtitle"
            android:textColor="#6E7C90"
            android:textSize="@dimen/sp_6"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
