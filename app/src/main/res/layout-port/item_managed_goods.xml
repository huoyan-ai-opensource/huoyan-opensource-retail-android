<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_48"
    android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/dp_6"
    android:background="@drawable/land_card">

    <LinearLayout
        android:layout_width="@dimen/dp_0"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp_8"
            android:textColor="#293A51"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:id="@+id/manageName"
            android:layout_weight="0"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp_6"
            android:textColor="#637187"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:id="@+id/managePlu" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp_6"
            android:textColor="#637187"
            android:fontFamily="@font/retail_sans"
            android:includeFontPadding="false"
            android:id="@+id/managePrice" />
    </LinearLayout>

    <TextView
        android:id="@+id/manageLearned"
        android:layout_width="@dimen/dp_36"
        android:layout_height="wrap_content"
        android:textSize="@dimen/sp_7"
        android:textColor="#637187"
        android:gravity="center_vertical" />

    <TextView
        android:layout_width="@dimen/dp_36"
        android:layout_height="@dimen/dp_24"
        android:textSize="@dimen/sp_7"
        android:textColor="#3F3EED"
        android:fontFamily="@font/retail_sans"
        android:includeFontPadding="false"
        android:text="@string/goods_learn_short"
        android:id="@+id/manageLearn"
        android:gravity="center"
        android:paddingHorizontal="@dimen/dp_2"
        android:background="@drawable/land_soft"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginStart="@dimen/dp_2" />

    <TextView
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:textSize="@dimen/sp_7"
        android:textColor="#3F3EED"
        android:fontFamily="@font/retail_sans"
        android:includeFontPadding="false"
        android:text="@string/learning_edit"
        android:id="@+id/manageEdit"
        android:gravity="center"
        android:paddingHorizontal="@dimen/dp_2"
        android:background="@drawable/land_soft"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginStart="@dimen/dp_2" />

    <TextView
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:textSize="@dimen/sp_7"
        android:textColor="#D92D20"
        android:fontFamily="@font/retail_sans"
        android:includeFontPadding="false"
        android:text="@string/learning_delete"
        android:id="@+id/manageDelete"
        android:gravity="center"
        android:paddingHorizontal="@dimen/dp_2"
        android:background="@drawable/land_danger"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginStart="@dimen/dp_2" />
</LinearLayout>