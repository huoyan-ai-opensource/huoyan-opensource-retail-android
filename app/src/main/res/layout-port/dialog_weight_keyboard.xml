<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#70142033"
    android:focusableInTouchMode="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="@dimen/dp_8"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dp_12"
                android:background="@drawable/land_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_21"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/dp_0">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_12"
                        android:textColor="#293A51"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:id="@+id/keyboardTitle"
                        android:text="@string/dialog_title_modify_weight"
                        android:textStyle="bold"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_35"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/dp_7">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_16"
                        android:textColor="#3F3EED"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:id="@+id/weightText"
                        android:background="@drawable/land_field"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_30"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/dp_11">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_14"
                        android:textColor="#293A51"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:id="@+id/num1"
                        android:text="1"
                        android:background="@drawable/land_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_0" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_14"
                        android:textColor="#293A51"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:id="@+id/num2"
                        android:text="2"
                        android:background="@drawable/land_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_6" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_14"
                        android:textColor="#293A51"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:id="@+id/num3"
                        android:text="3"
                        android:background="@drawable/land_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_6" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_30"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/dp_5">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_14"
                        android:textColor="#293A51"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:id="@+id/num4"
                        android:text="4"
                        android:background="@drawable/land_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_0" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_14"
                        android:textColor="#293A51"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:id="@+id/num5"
                        android:text="5"
                        android:background="@drawable/land_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_6" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_14"
                        android:textColor="#293A51"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:id="@+id/num6"
                        android:text="6"
                        android:background="@drawable/land_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_6" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_30"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/dp_5">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_14"
                        android:textColor="#293A51"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:id="@+id/num7"
                        android:text="7"
                        android:background="@drawable/land_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_0" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_14"
                        android:textColor="#293A51"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:id="@+id/num8"
                        android:text="8"
                        android:background="@drawable/land_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_6" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_14"
                        android:textColor="#293A51"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:id="@+id/num9"
                        android:text="9"
                        android:background="@drawable/land_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_6" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_30"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/dp_5">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_14"
                        android:textColor="#293A51"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:id="@+id/dot"
                        android:text="@string/button_dot"
                        android:background="@drawable/land_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_0" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_14"
                        android:textColor="#293A51"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:id="@+id/num0"
                        android:text="0"
                        android:background="@drawable/land_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_6" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_11"
                        android:textColor="@color/keypad_action"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:id="@+id/backspace"
                        android:text="@string/button_delete"
                        android:background="@drawable/keypad_backspace"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_6" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_30"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/dp_8">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_11"
                        android:textColor="#293A51"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:id="@+id/cancel"
                        android:text="@string/button_cancel"
                        android:background="@drawable/land_secondary"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_0" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_11"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:id="@+id/confirm"
                        android:text="@string/button_ok"
                        android:background="@drawable/land_primary"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_6" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
