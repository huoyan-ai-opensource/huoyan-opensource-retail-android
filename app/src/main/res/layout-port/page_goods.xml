<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ns1="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F4F8">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/dp_10"
            android:paddingRight="@dimen/dp_10"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dp_10"
                android:background="@drawable/land_card"
                android:layout_marginStart="@dimen/dp_0"
                android:layout_marginTop="@dimen/dp_0">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_17_5"
                    android:textSize="@dimen/sp_12"
                    android:textColor="#293A51"
                    android:includeFontPadding="false"
                    android:gravity="center_vertical"
                    android:text="@string/goods_tab_record"
                    android:textStyle="bold"
                    android:fontFamily="@font/retail_sans" />

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_12" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:id="@+id/localGoodsRow"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#293A51"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="@string/land_local_goods"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:id="@+id/goodsCount"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:text="@string/land_placeholder"
                        android:fontFamily="@font/retail_sans"
                        android:layout_weight="1"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="@dimen/dp_12"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_13"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:text="@string/land_chevron"
                        android:fontFamily="@font/retail_sans" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_12" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:id="@+id/learnedGoodsRow"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#293A51"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="@string/goods_learned_label"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:id="@+id/libraryLocalCount"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:text="@string/land_placeholder"
                        android:fontFamily="@font/retail_sans"
                        android:layout_weight="1"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="@dimen/dp_12"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_13"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:text="@string/land_chevron"
                        android:fontFamily="@font/retail_sans" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_12" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:id="@+id/openLearning"
                    android:background="@drawable/land_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="@string/goods_management_open"
                            android:fontFamily="@font/retail_sans"
                            android:textSize="@dimen/sp_9"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </FrameLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_12" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_8"
                    android:textColor="#6E7C90"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="@dimen/dp_1_5"
                    android:text="@string/goods_management_hint"
                    android:fontFamily="@font/retail_sans" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dp_10"
                android:background="@drawable/land_card"
                android:layout_marginStart="@dimen/dp_0"
                android:layout_marginTop="@dimen/dp_10">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_17_5"
                    android:textSize="@dimen/sp_12"
                    android:textColor="#293A51"
                    android:includeFontPadding="false"
                    android:gravity="center_vertical"
                    android:text="@string/goods_tab_library"
                    android:textStyle="bold"
                    android:fontFamily="@font/retail_sans" />

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_10" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_8"
                    android:textColor="#6E7C90"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="@dimen/dp_1_5"
                    android:text="@string/land_latest_backup"
                    android:fontFamily="@font/retail_sans" />

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_10" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/libraryBackupTime"
                    android:textSize="@dimen/sp_14"
                    android:textColor="#293A51"
                    android:includeFontPadding="false"
                    android:text="@string/land_placeholder"
                    android:textStyle="bold"
                    android:fontFamily="@font/retail_sans" />

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_10" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26">

                    <FrameLayout
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="@dimen/dp_26"
                        android:id="@+id/backupRecognitionLibrary"
                        android:background="@drawable/land_primary"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_weight="1"
                        android:foreground="?android:attr/selectableItemBackground">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/dp_10"
                                android:layout_height="@dimen/dp_10"
                                android:src="@drawable/land_icon_database"
                                ns1:tint="#FFFFFF"
                                android:layout_marginEnd="@dimen/dp_5" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="@string/library_backup"
                                android:fontFamily="@font/retail_sans"
                                android:textSize="@dimen/sp_9"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="@dimen/dp_26"
                        android:id="@+id/restoreRecognitionLibrary"
                        android:background="@drawable/land_soft"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_8"
                        android:foreground="?android:attr/selectableItemBackground">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/dp_10"
                                android:layout_height="@dimen/dp_10"
                                android:src="@drawable/land_icon_rotate_ccw"
                                ns1:tint="#3F3EED"
                                android:layout_marginEnd="@dimen/dp_5" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="@string/library_restore"
                                android:fontFamily="@font/retail_sans"
                                android:textSize="@dimen/sp_9"
                                android:textColor="#3F3EED"
                                android:textStyle="bold"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_10" />

                <TextView
                    android:id="@+id/learnImagePackage"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:background="@drawable/land_soft"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/library_image_learning"
                    android:textSize="@dimen/sp_9"
                    android:textStyle="bold"
                    android:textColor="#3F3EED"
                    android:fontFamily="@font/retail_sans"
                    android:includeFontPadding="false" />

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_10" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_24"
                    android:textSize="@dimen/sp_8"
                    android:textColor="#D26527"
                    android:includeFontPadding="false"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/dp_8"
                    android:background="@drawable/land_warning"
                    android:text="@string/land_restore_warning"
                    android:fontFamily="@font/retail_sans" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
