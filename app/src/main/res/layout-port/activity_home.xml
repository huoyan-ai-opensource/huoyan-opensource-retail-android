<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F2F4F8" android:padding="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:background="#FFFFFF" android:gravity="center_vertical" android:paddingHorizontal="@dimen/ui_page_horizontal">
        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@mipmap/ic_launcher" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/home_title" android:textColor="#293A51" android:textSize="20sp" android:textStyle="bold" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/aboutDevice" android:layout_width="112dp" android:layout_height="48dp" android:gravity="center" android:text="@string/home_about_device" android:textColor="#3F3EED" android:textSize="16sp" android:textStyle="bold" android:background="@drawable/land_soft" android:clickable="true" android:focusable="true" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:background="#FFFFFF" android:gravity="center_vertical" android:paddingHorizontal="@dimen/ui_page_horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="#293A51" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/homeStoreSubtitle" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
            <TextClock android:includeFontPadding="false" android:gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="24dp" android:format12Hour="yyyy-MM-dd E  HH:mm:ss" android:format24Hour="yyyy-MM-dd E  HH:mm:ss" android:textSize="13sp" android:textColor="#6E7C90" android:fontFamily="@font/retail_sans" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:paddingHorizontal="12dp" android:background="@drawable/land_soft" android:id="@+id/homeCloudStatus" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#8795A8" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:text="●" android:id="@+id/homeCloudDot" android:layout_marginEnd="8dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#293A51" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:text="@string/cloud_title" android:id="@+id/homeCloudLabel" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/enterCheckout" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="156dp" android:orientation="vertical" android:background="@drawable/home_checkout_card" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground" android:layout_marginHorizontal="@dimen/ui_page_horizontal" android:layout_marginTop="16dp" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="12dp" android:src="@drawable/home_icon_product_scan" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="36dp" android:text="@string/home_checkout" android:textSize="27sp" android:textColor="#FFFFFF" android:gravity="center_vertical" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_checkout_subtitle" android:textSize="14sp" android:textColor="#FFFFFF" android:gravity="center_vertical" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/homeActivationHint" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/home_enter_checkout" android:textSize="18sp" android:textColor="#3F3EED" android:gravity="center" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:background="@drawable/land_card" android:paddingHorizontal="@dimen/ui_page_horizontal" android:layout_marginTop="8dp" android:drawableEnd="@drawable/land_icon_arrow_right" android:textStyle="bold" android:id="@+id/homeCheckoutAction" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="16dp" android:fillViewport="false" android:clipToPadding="false" android:paddingHorizontal="@dimen/ui_page_horizontal" android:paddingBottom="0dp" android:id="@+id/homeFeaturesScroll" android:scrollbars="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:orientation="horizontal" android:layout_marginBottom="12dp">
                <include android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="0dp" layout="@layout/home_feature_sdk" />
                <include android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="12dp" layout="@layout/home_feature_recognition" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:orientation="horizontal" android:layout_marginBottom="12dp">
                <include android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="0dp" layout="@layout/home_feature_learning" />
                <include android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="12dp" layout="@layout/home_feature_camera" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:orientation="horizontal" android:layout_marginBottom="12dp">
                <include android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="0dp" layout="@layout/home_feature_scale" />
                <include android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="12dp" layout="@layout/home_feature_print" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:orientation="horizontal" android:layout_marginBottom="12dp">
                <include android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="0dp" layout="@layout/home_feature_goods" />
                <include android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="12dp" layout="@layout/home_feature_shop" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:orientation="horizontal" android:layout_marginBottom="12dp">
                <include android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="0dp" layout="@layout/home_feature_maintenance" />
                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:layout_marginStart="12dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <TextView android:id="@+id/homeMoreFeatures" android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginHorizontal="@dimen/ui_page_horizontal" android:gravity="center" android:text="@string/home_more_features" android:textColor="#3F3EED" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/land_soft" android:visibility="invisible" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="84dp">
        <cc.huoyan.retail.common.ui.BrandWatermarkView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginHorizontal="@dimen/ui_page_horizontal" android:layout_marginBottom="16dp" android:orientation="vertical" android:gravity="center_vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#66758B" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/homeClientVersion" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="horizontal" android:gravity="center_vertical">
                        <ProgressBar android:id="@+id/homeSdkStartupProgress" style="?android:attr/progressBarStyleSmall" android:layout_width="12dp" android:layout_height="12dp" android:layout_marginEnd="6dp" android:indeterminate="true" android:indeterminateTint="#3F3EED" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/homeSdkVersion" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/home_sdk_starting" android:textSize="12sp" android:textColor="#66758B" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:accessibilityLiveRegion="polite" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#66758B" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/homeSerial" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#66758B" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/homeConnection" android:layout_marginTop="5dp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:layout_marginTop="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#66758B" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:text="@string/home_copyright" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>