<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F4F8">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/dp_10"
            android:paddingRight="@dimen/dp_10"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dp_10"
                android:background="@drawable/land_card"
                android:layout_marginStart="@dimen/dp_0"
                android:layout_marginTop="@dimen/dp_0">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_17_5"
                    android:textSize="@dimen/sp_12"
                    android:textColor="#293A51"
                    android:includeFontPadding="false"
                    android:gravity="center_vertical"
                    android:text="@string/land_device_information"
                    android:textStyle="bold"
                    android:fontFamily="@font/retail_sans" />

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_4" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#293A51"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="@string/panel_client_version"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:id="@+id/app_version"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:text="@string/land_placeholder"
                        android:fontFamily="@font/retail_sans"
                        android:layout_weight="2" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_4" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#293A51"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="@string/land_sdk_version"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:id="@+id/sdk_version"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:text="@string/land_placeholder"
                        android:fontFamily="@font/retail_sans"
                        android:layout_weight="2" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_4" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#293A51"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="@string/panel_device_model"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:id="@+id/device_model"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:text="@string/land_placeholder"
                        android:fontFamily="@font/retail_sans"
                        android:layout_weight="2" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_4" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#293A51"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="@string/panel_hardware_serial"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:id="@+id/hardware_serial"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:text="@string/land_placeholder"
                        android:fontFamily="@font/retail_sans"
                        android:layout_weight="2" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_4" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/land_field"
                    android:paddingHorizontal="@dimen/dp_8">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#293A51"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="@string/panel_cloud_service"
                        android:fontFamily="@font/retail_sans" />

                    <cc.huoyan.retail.common.ui.LandscapeSwitch
                        android:layout_width="@dimen/dp_26"
                        android:layout_height="@dimen/dp_24"
                        android:id="@+id/cloudServiceSwitch"
                        android:thumb="@drawable/land_switch_thumb"
                        android:track="@drawable/land_switch_track"
                        android:splitTrack="false"
                        android:thumbTint="@null"
                        android:trackTint="@null"
                        android:switchMinWidth="@dimen/dp_26"
                        android:padding="@dimen/dp_0" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/land_card"
                android:layout_marginStart="@dimen/dp_0"
                android:layout_marginTop="@dimen/dp_10"
                android:padding="@dimen/dp_10">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_17_5"
                    android:textSize="@dimen/sp_12"
                    android:textColor="#293A51"
                    android:includeFontPadding="false"
                    android:gravity="center_vertical"
                    android:text="@string/land_license_status"
                    android:textStyle="bold"
                    android:fontFamily="@font/retail_sans" />

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_4" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/dp_4">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#293A51"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="@string/panel_activation_status"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:id="@+id/active_status"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:text="@string/text_unavailable"
                        android:fontFamily="@font/retail_sans"
                        android:layout_weight="2"
                        android:maxLines="2"
                        android:ellipsize="end" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/dp_4">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#293A51"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="@string/panel_activation_time"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:id="@+id/service_start_time"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:text="@string/text_unavailable"
                        android:fontFamily="@font/retail_sans"
                        android:layout_weight="2"
                        android:maxLines="2"
                        android:ellipsize="end" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/dp_4">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#293A51"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="@string/panel_activation_expire"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:id="@+id/service_expire_time"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:text="@string/text_unavailable"
                        android:fontFamily="@font/retail_sans"
                        android:layout_weight="2"
                        android:maxLines="2"
                        android:ellipsize="end" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#293A51"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="@string/panel_activation_serial_type"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:id="@+id/serial_type"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:text="@string/text_unavailable"
                        android:fontFamily="@font/retail_sans"
                        android:layout_weight="2"
                        android:maxLines="2"
                        android:ellipsize="end" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_4" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:id="@+id/activate"
                    android:textSize="@dimen/sp_8"
                    android:textColor="#FFFFFF"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:background="@drawable/land_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/land_activate_device"
                    android:fontFamily="@font/retail_sans" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
