<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F4F8">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/dp_10"
            android:paddingRight="@dimen/dp_10"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dp_10"
                android:background="@drawable/land_card"
                android:layout_marginStart="@dimen/dp_0"
                android:layout_marginTop="@dimen/dp_0">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_17_5"
                    android:textSize="@dimen/sp_12"
                    android:textColor="#293A51"
                    android:includeFontPadding="false"
                    android:gravity="center_vertical"
                    android:text="@string/land_camera_display_settings"
                    android:textStyle="bold"
                    android:fontFamily="@font/retail_sans" />

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_9" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:id="@+id/cameraTypeLayout"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#293A51"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="@string/settings_camera_type"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:id="@+id/cameraType"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:text="@string/camera_type_uvc"
                        android:fontFamily="@font/retail_sans"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="@dimen/dp_12"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_13"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:text="@string/land_chevron"
                        android:fontFamily="@font/retail_sans" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_9" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:id="@+id/cameraNameLayout"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#293A51"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="@string/settings_camera_select"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:id="@+id/cameraName"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:text="@string/settings_camera_select"
                        android:fontFamily="@font/retail_sans"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="@dimen/dp_12"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_13"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:text="@string/land_chevron"
                        android:fontFamily="@font/retail_sans" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_9" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_26"
                    android:id="@+id/cameraResolutionLayout"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#293A51"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="@string/settings_camera_resolution_label"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:id="@+id/cameraResolution"
                        android:textSize="@dimen/sp_9"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:text="@string/land_placeholder"
                        android:fontFamily="@font/retail_sans"
                        android:layout_weight="1"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="@dimen/dp_12"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_13"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:gravity="end"
                        android:text="@string/land_chevron"
                        android:fontFamily="@font/retail_sans" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_9" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_36"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/sp_10"
                            android:textColor="#293A51"
                            android:includeFontPadding="false"
                            android:text="@string/settings_camera_mirror"
                            android:textStyle="bold"
                            android:fontFamily="@font/retail_sans" />

                        <Space
                            android:layout_width="@dimen/dp_0_5"
                            android:layout_height="@dimen/dp_3" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/sp_7_5"
                            android:textColor="#6E7C90"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="@dimen/dp_1_5"
                            android:text="@string/land_mirror_hint"
                            android:fontFamily="@font/retail_sans" />
                    </LinearLayout>

                    <cc.huoyan.retail.common.ui.LandscapeSwitch
                        android:layout_width="@dimen/dp_26"
                        android:layout_height="@dimen/dp_24"
                        android:id="@+id/cameraMirror"
                        android:showText="false"
                        android:thumb="@drawable/land_switch_thumb"
                        android:track="@drawable/land_switch_track"
                        android:splitTrack="false"
                        android:switchMinWidth="@dimen/dp_26"
                        android:thumbTint="@null"
                        android:trackTint="@null"
                        android:padding="@dimen/dp_0" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_9" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_8"
                    android:textColor="#6E7C90"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="@dimen/dp_1_5"
                    android:text="@string/land_camera_setup_hint"
                    android:fontFamily="@font/retail_sans" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dp_10"
                android:background="@drawable/land_card"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_0"
                android:layout_marginTop="@dimen/dp_10">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_18"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_11"
                        android:textColor="#293A51"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:text="@string/settings_camera_preview"
                        android:textStyle="bold"
                        android:fontFamily="@font/retail_sans" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/cameraStatus"
                        android:textSize="@dimen/sp_8"
                        android:textColor="#6E7C90"
                        android:includeFontPadding="false"
                        android:text="@string/land_disconnected"
                        android:fontFamily="@font/retail_sans" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_8" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_0"
                    android:layout_weight="1"
                    android:minHeight="@dimen/dp_100"
                    android:background="@drawable/land_preview"
                    android:clipToOutline="true">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:id="@+id/imageViewText"
                        android:textSize="@dimen/sp_11"
                        android:textColor="#FFFFFF"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:text="@string/land_device_preview"
                        android:fontFamily="@font/retail_sans" />

                    <cc.huoyan.retail.device.camera.AutoFitTextureView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:id="@+id/surfaceView"
                        android:layout_gravity="center" />

                    <cc.huoyan.retail.device.camera.ResizableDashedBoxView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:id="@+id/boxView" />
                </FrameLayout>

                <Space
                    android:layout_width="@dimen/dp_0_5"
                    android:layout_height="@dimen/dp_8" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_7_5"
                    android:textColor="#6E7C90"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="@dimen/dp_1_5"
                    android:text="@string/land_camera_coordinates_hint"
                    android:fontFamily="@font/retail_sans" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
