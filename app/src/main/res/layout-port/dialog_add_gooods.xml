<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#70142033" android:focusableInTouchMode="true">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:padding="16dp" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <LinearLayout android:layout_width="match_parent" android:layout_height="510dp" android:orientation="vertical" android:padding="20dp" android:background="@drawable/land_card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:orientation="horizontal" android:layout_marginTop="0dp">
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:textSize="24sp" android:textColor="#293A51" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:gravity="center" android:id="@+id/goodsName" android:text="@string/goods_add_title" android:textStyle="bold" android:layout_weight="1" android:layout_marginStart="0dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="26dp" android:orientation="horizontal" android:layout_marginTop="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:textSize="17sp" android:textColor="#293A51" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:gravity="center_vertical" android:id="@+id/goodsPluLabel" android:text="@string/land_goods_plu" android:layout_weight="1" android:layout_marginStart="0dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:layout_marginTop="4dp">
                    <EditText android:layout_width="0dp" android:layout_height="match_parent" android:textSize="16sp" android:textColor="#293A51" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:gravity="start|center_vertical" android:id="@+id/plu" android:hint="@string/goods_plu_hint" android:textColorHint="#6E7C90" android:background="@drawable/land_field" android:singleLine="true" android:inputType="textVisiblePassword" android:paddingHorizontal="16dp" android:layout_weight="1" android:layout_marginStart="0dp" android:textAlignment="viewStart" android:maxLength="32" android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="26dp" android:orientation="horizontal" android:layout_marginTop="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:textSize="17sp" android:textColor="#293A51" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:gravity="center_vertical" android:id="@+id/goodsNameLabel" android:text="@string/land_goods_name" android:layout_weight="1" android:layout_marginStart="0dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:layout_marginTop="4dp">
                    <EditText android:layout_width="0dp" android:layout_height="match_parent" android:textSize="16sp" android:textColor="#293A51" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:gravity="start|center_vertical" android:id="@+id/name" android:hint="@string/goods_name_hint" android:textColorHint="#6E7C90" android:background="@drawable/land_field" android:singleLine="true" android:inputType="text" android:paddingHorizontal="16dp" android:layout_weight="1" android:layout_marginStart="0dp" android:textAlignment="viewStart" android:maxLength="64" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="26dp" android:textSize="17sp" android:textColor="#293A51" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:gravity="center_vertical" android:id="@+id/goodsPriceLabel" android:text="@string/goods_price_weight" /><TextView android:layout_width="match_parent" android:layout_height="48dp" android:textSize="16sp" android:textColor="#293A51" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:gravity="start|center_vertical" android:id="@+id/price" android:hint="@string/goods_price_hint" android:textColorHint="#6E7C90" android:background="@drawable/land_field" android:singleLine="true" android:paddingHorizontal="16dp" android:textAlignment="viewStart" android:clickable="true" android:focusable="true" android:freezesText="true" /></LinearLayout>
<LinearLayout android:id="@+id/goodsTareField" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="12dp" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="26dp" android:includeFontPadding="false" android:gravity="center_vertical" android:text="@string/goods_tare_label" android:textSize="17sp" android:textColor="#293A51" android:fontFamily="@font/retail_sans" /><TextView android:id="@+id/goodsTare" android:layout_width="match_parent" android:layout_height="48dp" android:text="0" android:textSize="16sp" android:textColor="#293A51" android:fontFamily="@font/retail_sans" android:background="@drawable/land_field" android:paddingHorizontal="16dp" android:singleLine="true" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:freezesText="true" /></LinearLayout></LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="26dp" android:orientation="horizontal" android:layout_marginTop="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:textSize="17sp" android:textColor="#293A51" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:gravity="center_vertical" android:id="@+id/goodsPricingLabel" android:text="@string/land_goods_pricing" android:layout_weight="1" android:layout_marginStart="0dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:layout_marginTop="10dp">
                    <RadioGroup android:id="@+id/pricingType" android:layout_width="0dp" android:layout_height="match_parent" android:orientation="horizontal" android:layout_weight="1" android:layout_marginStart="0dp">
                        <RadioButton android:id="@+id/pricingTypeWeight" android:layout_width="0dp" android:layout_height="match_parent" android:button="@null" android:background="@drawable/land_pricing_option" android:gravity="center" android:text="@string/goods_pricing_type_weight" android:textColor="@color/goods_pricing_text" android:textSize="16sp" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:checked="true" android:layout_weight="1" android:layout_marginStart="0dp" />
                        <RadioButton android:id="@+id/pricingTypeCount" android:layout_width="0dp" android:layout_height="match_parent" android:button="@null" android:background="@drawable/land_pricing_option" android:gravity="center" android:text="@string/goods_pricing_type_count" android:textColor="@color/goods_pricing_text" android:textSize="16sp" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:layout_marginLeft="12dp" android:layout_weight="1" android:layout_marginStart="12dp" />
                    </RadioGroup>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:layout_marginTop="20dp">
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:textSize="16sp" android:textColor="#293A51" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:gravity="center" android:id="@+id/close" android:text="@string/button_close" android:background="@drawable/land_secondary" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground" android:layout_weight="1" android:layout_marginStart="0dp" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:textSize="16sp" android:textColor="#FFFFFF" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:gravity="center" android:id="@+id/confirm" android:text="@string/button_ok" android:background="@drawable/land_primary" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground" android:layout_weight="1" android:layout_marginStart="12dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
