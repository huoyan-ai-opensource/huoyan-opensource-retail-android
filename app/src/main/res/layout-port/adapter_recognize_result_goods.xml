<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp">
  <LinearLayout android:id="@+id/cardContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="94dp" android:background="@drawable/bg_similar_choice_item" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal">
    <View android:id="@+id/colorBlock" android:layout_width="10dp" android:layout_height="match_parent" />
    <LinearLayout android:id="@+id/goodsInfoArea" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
      <TextView android:id="@+id/goodsName" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="#293A51" android:textSize="18sp" android:textStyle="bold" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/goodsPlu" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#89000000" android:textSize="16sp" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/goodsPrice" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#B54708" android:textSize="16sp" android:textStyle="bold" />
      </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/countArea" android:layout_width="84dp" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
      <TextView android:id="@+id/goodsCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#293A51" android:textSize="36sp" android:textStyle="bold" />
      <TextView android:id="@+id/goodsCountUnit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#89000000" android:textSize="16sp" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:layout_width="60dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp" android:layout_marginEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp">
      <TextView android:id="@+id/modifyCount" android:layout_width="60dp" android:layout_height="48dp" android:background="@drawable/btn_main_bg" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/label_modify" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" />
      <TextView android:id="@+id/deleteGoods" android:layout_width="60dp" android:layout_height="48dp" android:background="@drawable/bg_recognition_delete" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/label_delete_recognition" android:textColor="#B42318" android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="4dp" android:visibility="gone" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
