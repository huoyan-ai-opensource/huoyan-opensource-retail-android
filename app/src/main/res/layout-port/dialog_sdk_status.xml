<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#70142033"
    android:padding="@dimen/dp_10">

    <cc.huoyan.retail.common.ui.BoundedDialogLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dp_12"
        android:background="@drawable/land_card"
        android:id="@+id/boundedCheckoutDialog"
        android:layout_gravity="center">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_19"
                android:text="@string/checkout_sdk_title"
                android:textSize="@dimen/sp_12"
                android:textColor="#293A51"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:textStyle="bold" />

            <TextView
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:text="×"
                android:textSize="@dimen/sp_13"
                android:textColor="#6E7C90"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:id="@+id/closeSdkIcon"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/checkout_close" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0"
            android:layout_weight="1"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_28_5"
                    android:text="@string/checkout_sdk_unavailable"
                    android:textSize="@dimen/sp_10"
                    android:textColor="#293A51"
                    android:fontFamily="@font/retail_sans"
                    android:includeFontPadding="false"
                    android:id="@+id/sdkHealth"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/dp_7"
                    android:background="@drawable/land_field"
                    android:textStyle="bold"
                    android:layout_marginTop="@dimen/dp_7" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:minHeight="@dimen/dp_15"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/dp_7">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/checkout_sdk_connection"
                        android:textSize="@dimen/sp_8"
                        android:textColor="#6E7C90"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="@dimen/sp_8"
                        android:textColor="#293A51"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:id="@+id/sdkConnection"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:layout_marginStart="@dimen/dp_8" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:minHeight="@dimen/dp_15"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/dp_7">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/checkout_sdk_authorization"
                        android:textSize="@dimen/sp_8"
                        android:textColor="#6E7C90"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="@dimen/sp_8"
                        android:textColor="#293A51"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:id="@+id/sdkAuthorization"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:layout_marginStart="@dimen/dp_8" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:minHeight="@dimen/dp_15"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/dp_7">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/checkout_sdk_initialization"
                        android:textSize="@dimen/sp_8"
                        android:textColor="#6E7C90"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="@dimen/sp_8"
                        android:textColor="#293A51"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:id="@+id/sdkInitialization"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:layout_marginStart="@dimen/dp_8" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:minHeight="@dimen/dp_15"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/dp_7">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/checkout_sdk_checked_at"
                        android:textSize="@dimen/sp_8"
                        android:textColor="#6E7C90"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="@dimen/sp_8"
                        android:textColor="#293A51"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:id="@+id/sdkCheckedAt"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:layout_marginStart="@dimen/dp_8" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/land_field"
                    android:padding="@dimen/dp_8"
                    android:layout_marginTop="@dimen/dp_7">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/checkout_sdk_errors"
                        android:textSize="@dimen/sp_8"
                        android:textColor="#293A51"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="@dimen/sp_8"
                        android:textColor="#6E7C90"
                        android:fontFamily="@font/retail_sans"
                        android:includeFontPadding="false"
                        android:id="@+id/sdkDetails"
                        android:textIsSelectable="true"
                        android:layout_marginTop="@dimen/dp_4"
                        android:lineSpacingExtra="@dimen/dp_2" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/dp_7">

            <TextView
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_26"
                android:text="@string/checkout_close"
                android:textSize="@dimen/sp_9"
                android:textColor="#3F3EED"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:id="@+id/closeDialog"
                android:layout_weight="1"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/land_soft" />

            <TextView
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_26"
                android:text="@string/checkout_sdk_refresh"
                android:textSize="@dimen/sp_9"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/retail_sans"
                android:includeFontPadding="false"
                android:id="@+id/refreshSdk"
                android:layout_weight="1"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/land_primary"
                android:layout_marginStart="@dimen/dp_6" />
        </LinearLayout>
    </cc.huoyan.retail.common.ui.BoundedDialogLayout>
</FrameLayout>
