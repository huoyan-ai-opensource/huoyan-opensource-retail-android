<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#70142033" android:padding="20dp">
  <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:background="@drawable/land_card" android:id="@+id/checkoutDialogCard">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/checkout_password_setup_title" android:textSize="24sp" android:textColor="#293A51" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/passwordTitle" android:textStyle="bold" android:layout_marginBottom="16dp" android:minHeight="35dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/checkout_password_purpose" android:textSize="16sp" android:textColor="#6E7C90" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/passwordPurpose" android:layout_marginBottom="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/checkout_new_password" android:textSize="16sp" android:textColor="#293A51" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/passwordLabel" android:layout_marginBottom="12dp" android:minHeight="23dp" />
            <TextView android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/checkout_password" android:textSize="18sp" android:textColor="#6E7C90" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/passwordInput" android:background="@drawable/bg_password_field" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:clickable="true" android:focusable="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/checkout_confirm_password" android:textSize="16sp" android:textColor="#293A51" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/passwordRepeatLabel" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:minHeight="23dp" />
            <TextView android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/checkout_password_repeat" android:textSize="18sp" android:textColor="#6E7C90" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/passwordRepeat" android:background="@drawable/bg_password_field" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:clickable="true" android:focusable="true" />
          </LinearLayout>
          <include android:id="@+id/passwordKeyboard" layout="@layout/checkout_password_keyboard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp">
          <TextView android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/button_cancel" android:textSize="18sp" android:textColor="#3F3EED" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/closeDialog" android:gravity="center" android:clickable="true" android:focusable="true" android:background="@drawable/land_soft" />
          <TextView android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/checkout_save_password" android:textSize="18sp" android:textColor="#FFFFFF" android:fontFamily="@font/retail_sans" android:includeFontPadding="false" android:id="@+id/confirmPassword" android:gravity="center" android:clickable="true" android:focusable="true" android:background="@drawable/land_primary" android:layout_marginTop="12dp" />
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
</FrameLayout>
