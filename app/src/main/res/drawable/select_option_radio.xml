<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <size android:width="@dimen/dp_12" android:height="@dimen/dp_12" />
                    <solid android:color="#3F3EED" />
                </shape>
            </item>
            <item android:left="@dimen/dp_4" android:top="@dimen/dp_4" android:right="@dimen/dp_4" android:bottom="@dimen/dp_4">
                <shape android:shape="oval">
                    <solid android:color="#FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="oval">
            <size android:width="@dimen/dp_12" android:height="@dimen/dp_12" />
            <stroke android:width="@dimen/dp_1" android:color="#ADB7C6" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
