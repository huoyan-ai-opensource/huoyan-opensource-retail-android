        },
        {
          "type": "text",
          "id": "okQOr",
          "name": "语言与英文显示规则",
          "fill": "#293A51",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "默认跟随系统首选语言：中文（含繁体）使用中文，其余语言使用英文。语言行打开自定义单选列表，提供跟随系统、简体中文、English；手动选择保存并立即生效，重新选择跟随系统恢复自动切换。\n英文商品用词统一为 product / products；英文品牌统一为 fieryeyes。\n英文金额统一使用 $，覆盖商品单价、收银汇总、选择弹窗及打印小票；中文金额保持原样。",
          "fontFamily": "Noto Sans SC",
          "fontSize": 18,
          "fontWeight": "normal"
        }
      ]
    }
