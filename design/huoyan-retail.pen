            {
              "type": "text",
              "id": "vFoWv",
              "name": "交互规则",
              "fill": "#293A51",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "手输或扫码提交有效激活码 → 无参查询当前设备支持模型 → 自定义列表选模 → 使用本次激活码与模型编码激活。取消选择返回输入并保留草稿。切换缺少激活码时复用同一输入弹窗，确认后直接提交已选模型，不重新查询或再次选模。",
              "lineHeight": 1.5,
              "fontFamily": "Noto Sans SC",
              "fontSize": 20,
              "fontWeight": "normal"
