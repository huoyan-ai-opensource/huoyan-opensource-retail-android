# 复制为 local.properties，将 sdk.dir 换成本机 Android SDK 路径。
# Windows 也可以使用正斜杠；不要提交 local.properties。
sdk.dir=C:/Users/your-name/AppData/Local/Android/Sdk

# 可选：正式发布使用自己的签名时，必须同时配置下面四项。
# 默认公开实验签名只供非商业实验和测试使用。
# signing.storeFile=C:/private/retail-release.jks
# signing.storePassword=replace-locally
# signing.keyAlias=replace-locally
# signing.keyPassword=replace-locally
